{
  "dataSources": {
    "attendance": { "url": "/api/workforce/attendance" }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Attendance",
        "subtitle": "Track employee attendance and working hours"
      }
    },
    {
      "type": "Alert",
      "props": {
        "variant": "info",
        "title": "Under Development",
        "message": "Attendance tracking module is under development. Some features may not be available yet."
      }
    },
    {
      "type": "DataTable",
      "props": {
        "dataPath": "attendance",
        "searchable": true,
        "searchPlaceholder": "Search attendance records...",
        "paginated": true,
        "pageSize": 20,
        "emptyMessage": "No attendance records found.",
        "columns": [
          {
            "key": "employeeName",
            "header": "Employee",
            "sortable": true
          },
          {
            "key": "date",
            "header": "Date",
            "format": "date",
            "sortable": true
          },
          {
            "key": "checkIn",
            "header": "Check In",
            "format": "time",
            "sortable": true
          },
          {
            "key": "checkOut",
            "header": "Check Out",
            "format": "time",
            "sortable": true
          },
          {
            "key": "status",
            "header": "Status",
            "sortable": true,
            "render": {
              "type": "Badge",
              "props": {
                "valuePath": "status",
                "colorMap": {
                  "present": "green",
                  "absent": "red",
                  "half_day": "blue",
                  "holiday": "gray"
                }
              }
            }
          },
          {
            "key": "hours",
            "header": "Hours",
            "sortable": true
          }
        ]
      }
    }
  ]
}
