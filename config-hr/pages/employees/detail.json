{
  "dataSources": {
    "employee": { "url": "/api/employees/:id" },
    "documents": { "url": "/api/employees/:id/documents" }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "titleParts": [
          { "textPath": "employee.firstName" },
          { "text": " " },
          { "textPath": "employee.lastName" }
        ],
        "subtitle": "Employee Details",
        "actions": [
          {
            "label": "Edit",
            "variant": "secondary",
            "icon": "edit",
            "action": {
              "type": "navigate",
              "to": "/employees/:id/edit"
            }
          },
          {
            "label": "Delete",
            "variant": "danger",
            "icon": "trash",
            "action": {
              "type": "delete_confirm",
              "url": "/api/employees/:id",
              "message": "Are you sure you want to delete this employee? This action cannot be undone.",
              "redirectTo": "/employees"
            }
          }
        ]
      }
    },
    {
      "type": "Tabs",
      "props": {
        "defaultTab": "overview"
      },
      "children": [
        {
          "type": "TabPanel",
          "props": {
            "id": "overview",
            "label": "Overview"
          },
          "children": [
            {
              "type": "Grid",
              "props": {
                "columns": 2,
                "gap": "lg"
              },
              "children": [
                {
                  "type": "DetailSection",
                  "props": {
                    "title": "Personal Information"
                  },
                  "children": [
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Full Name",
                        "valuePath": "employee.firstName",
                        "template": "{{employee.firstName}} {{employee.lastName}}"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Email",
                        "valuePath": "employee.email"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Phone",
                        "valuePath": "employee.phone"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Date of Birth",
                        "valuePath": "employee.dateOfBirth",
                        "format": "date"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Gender",
                        "valuePath": "employee.gender"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Marital Status",
                        "valuePath": "employee.maritalStatus"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Nationality",
                        "valuePath": "employee.nationality"
                      }
                    }
                  ]
                },
                {
                  "type": "DetailSection",
                  "props": {
                    "title": "Address"
                  },
                  "children": [
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Address",
                        "valuePath": "employee.address"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "City",
                        "valuePath": "employee.city"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "State",
                        "valuePath": "employee.state"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Country",
                        "valuePath": "employee.country"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Postal Code",
                        "valuePath": "employee.postalCode"
                      }
                    }
                  ]
                },
                {
                  "type": "DetailSection",
                  "props": {
                    "title": "Employment"
                  },
                  "children": [
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Employee Code",
                        "valuePath": "employee.employeeCode"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Department",
                        "valuePath": "employee.departmentName"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Position",
                        "valuePath": "employee.positionTitle"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Manager",
                        "valuePath": "employee.managerName"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Join Date",
                        "valuePath": "employee.dateOfJoining",
                        "format": "date"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Employment Type",
                        "valuePath": "employee.employmentType"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Status",
                        "valuePath": "employee.status",
                        "render": {
                          "type": "Badge",
                          "props": {
                            "valuePath": "employee.status",
                            "colorMap": {
                              "active": "green",
                              "on_leave": "orange",
                              "terminated": "red",
                              "resigned": "gray"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "Stack",
                  "props": {
                    "direction": "vertical",
                    "gap": "lg"
                  },
                  "children": [
                    {
                      "type": "DetailSection",
                      "props": {
                        "title": "Emergency Contact"
                      },
                      "children": [
                        {
                          "type": "DetailRow",
                          "props": {
                            "label": "Name",
                            "valuePath": "employee.emergencyContactName"
                          }
                        },
                        {
                          "type": "DetailRow",
                          "props": {
                            "label": "Phone",
                            "valuePath": "employee.emergencyContactPhone"
                          }
                        },
                        {
                          "type": "DetailRow",
                          "props": {
                            "label": "Relation",
                            "valuePath": "employee.emergencyContactRelation"
                          }
                        }
                      ]
                    },
                    {
                      "type": "DetailSection",
                      "props": {
                        "title": "Bank Details"
                      },
                      "children": [
                        {
                          "type": "DetailRow",
                          "props": {
                            "label": "Bank Name",
                            "valuePath": "employee.bankName"
                          }
                        },
                        {
                          "type": "DetailRow",
                          "props": {
                            "label": "Account",
                            "valuePath": "employee.bankAccount"
                          }
                        },
                        {
                          "type": "DetailRow",
                          "props": {
                            "label": "IFSC",
                            "valuePath": "employee.bankIfsc"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "TabPanel",
          "props": {
            "id": "documents",
            "label": "Documents"
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "direction": "vertical",
                "gap": "md"
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "direction": "horizontal",
                    "justify": "flex-end"
                  },
                  "children": [
                    {
                      "type": "Button",
                      "props": {
                        "label": "Upload Document",
                        "variant": "primary",
                        "icon": "upload",
                        "action": {
                          "type": "navigate",
                          "to": "/employees/:id/documents/upload"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "DataTable",
                  "props": {
                    "dataPath": "documents",
                    "emptyMessage": "No documents uploaded yet.",
                    "columns": [
                      {
                        "key": "name",
                        "header": "Name",
                        "sortable": true
                      },
                      {
                        "key": "type",
                        "header": "Type",
                        "sortable": true
                      },
                      {
                        "key": "uploadedAt",
                        "header": "Uploaded At",
                        "format": "datetime",
                        "sortable": true
                      },
                      {
                        "key": "actions",
                        "header": "Actions",
                        "render": {
                          "type": "Stack",
                          "props": {
                            "direction": "horizontal",
                            "gap": "sm"
                          },
                          "children": [
                            {
                              "type": "Button",
                              "props": {
                                "label": "Download",
                                "variant": "ghost",
                                "size": "sm",
                                "icon": "download",
                                "action": {
                                  "type": "api_call",
                                  "method": "GET",
                                  "url": "/api/employees/:id/documents/{{row.id}}/download"
                                }
                              }
                            },
                            {
                              "type": "Button",
                              "props": {
                                "label": "Delete",
                                "variant": "ghost-danger",
                                "size": "sm",
                                "icon": "trash",
                                "action": {
                                  "type": "delete_confirm",
                                  "url": "/api/employees/:id/documents/{{row.id}}",
                                  "message": "Are you sure you want to delete this document?"
                                }
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "TabPanel",
          "props": {
            "id": "employment",
            "label": "Employment"
          },
          "children": [
            {
              "type": "Grid",
              "props": {
                "columns": 1,
                "gap": "lg"
              },
              "children": [
                {
                  "type": "DetailSection",
                  "props": {
                    "title": "Employment History"
                  },
                  "children": [
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Current Position",
                        "valuePath": "employee.positionTitle"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Current Department",
                        "valuePath": "employee.departmentName"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Date of Joining",
                        "valuePath": "employee.dateOfJoining",
                        "format": "date"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Employment Type",
                        "valuePath": "employee.employmentType"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Status",
                        "valuePath": "employee.status"
                      }
                    }
                  ]
                },
                {
                  "type": "DetailSection",
                  "props": {
                    "title": "Compensation"
                  },
                  "children": [
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Salary Structure",
                        "valuePath": "employee.salaryStructure"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Basic Salary",
                        "valuePath": "employee.basicSalary",
                        "format": "currency"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Gross Salary",
                        "valuePath": "employee.grossSalary",
                        "format": "currency"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
