{
  "table": "departments",
  "description": "Organizational departments",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true
    },
    {
      "name": "code",
      "type": "text",
      "unique": true,
      "notNull": true
    },
    {
      "name": "description",
      "type": "text"
    },
    {
      "name": "headId",
      "type": "text",
      "references": {
        "table": "users",
        "column": "id"
      }
    },
    {
      "name": "parentId",
      "type": "text",
      "references": {
        "table": "departments",
        "column": "id"
      }
    },
    {
      "name": "active",
      "type": "integer",
      "default": 1
    },
    {
      "name": "createdAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    }
  ]
}