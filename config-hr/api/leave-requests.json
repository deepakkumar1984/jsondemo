{
  "resource": "leaveRequests",
  "basePath": "/api/leave-requests",
  "description": "Leave request management with approval workflows",
  "table": "leaveRequests",
  "auth": {
    "required": true
  },
  "operations": {
    "list": {
      "enabled": true,
      "filters": [
        {
          "field": "employeeId",
          "operator": "equals",
          "queryParam": "employeeId"
        },
        {
          "field": "status",
          "operator": "equals",
          "queryParam": "status"
        },
        {
          "field": "leaveTypeId",
          "operator": "equals",
          "queryParam": "leaveTypeId"
        }
      ],
      "sort": {
        "default": "createdAt",
        "defaultOrder": "desc",
        "allowed": ["createdAt", "fromDate", "toDate", "status"]
      },
      "pagination": {
        "enabled": true,
        "defaultLimit": 50,
        "maxLimit": 100
      },
      "relations": [
        {
          "name": "employee",
          "table": "employees",
          "foreignKey": "employeeId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "leaveType",
          "table": "leaveTypes",
          "foreignKey": "leaveTypeId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "getById": {
      "enabled": true,
      "idField": "id",
      "relations": [
        {
          "name": "employee",
          "table": "employees",
          "foreignKey": "employeeId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "leaveType",
          "table": "leaveTypes",
          "foreignKey": "leaveTypeId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "approver",
          "table": "employees",
          "foreignKey": "approvedBy",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "create": {
      "enabled": true,
      "validation": {
        "required": ["employeeId", "leaveTypeId", "fromDate", "toDate", "days"],
        "fields": {
          "days": {
            "type": "number",
            "min": 0.5
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "cancelled"]
          }
        }
      },
      "defaults": {
        "status": "pending"
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "check_exists",
            "check_exists": {
              "table": "employees",
              "where": {
                "id": "{{body.employeeId}}"
              },
              "onNotExists": "return_error",
              "error": {
                "message": "Employee not found",
                "code": 404
              }
            }
          },
          {
            "type": "check_exists",
            "check_exists": {
              "table": "leaveTypes",
              "where": {
                "id": "{{body.leaveTypeId}}"
              },
              "onNotExists": "return_error",
              "error": {
                "message": "Leave type not found",
                "code": 404
              }
            }
          },
          {
            "type": "db_query",
            "db_query": {
              "action": "select",
              "table": "leaveRequests",
              "where": {
                "employeeId": "{{body.employeeId}}",
                "status": "pending"
              },
              "storeAs": "pendingRequests"
            }
          },
          {
            "type": "conditional",
            "conditional": {
              "condition": "pendingRequests.length > 5",
              "then": [
                {
                  "type": "return_error",
                  "return_error": {
                    "message": "Employee has too many pending leave requests. Please wait for approval.",
                    "code": 400
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "update": {
      "enabled": true,
      "idField": "id",
      "validation": {
        "fields": {
          "days": {
            "type": "number",
            "min": 0.5
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "cancelled"]
          }
        }
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "db_query",
            "db_query": {
              "action": "select",
              "table": "leaveRequests",
              "where": {
                "id": "{{params.id}}"
              },
              "limit": 1,
              "storeAs": "existingRequest"
            }
          },
          {
            "type": "conditional",
            "conditional": {
              "condition": {
                "field": "existingRequest.status",
                "operator": "in",
                "value": ["approved", "rejected"]
              },
              "then": [
                {
                  "type": "return_error",
                  "return_error": {
                    "message": "Cannot update a leave request that has already been processed",
                    "code": 400
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "delete": {
      "enabled": true,
      "idField": "id",
      "beforeExecute": {
        "steps": [
          {
            "type": "db_query",
            "db_query": {
              "action": "select",
              "table": "leaveRequests",
              "where": {
                "id": "{{params.id}}"
              },
              "limit": 1,
              "storeAs": "existingRequest"
            }
          },
          {
            "type": "conditional",
            "conditional": {
              "condition": {
                "field": "existingRequest.status",
                "operator": "equals",
                "value": "approved"
              },
              "then": [
                {
                  "type": "return_error",
                  "return_error": {
                    "message": "Cannot delete an approved leave request",
                    "code": 400
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "custom": [
      {
        "path": "/:id/approve",
        "method": "POST",
        "description": "Approve a leave request",
        "workflow": {
          "steps": [
            {
              "type": "check_exists",
              "check_exists": {
                "table": "leaveRequests",
                "where": {
                  "id": "{{params.id}}"
                },
                "onNotExists": "return_error",
                "error": {
                  "message": "Leave request not found",
                  "code": 404
                }
              }
            },
            {
              "type": "db_query",
              "db_query": {
                "action": "select",
                "table": "leaveRequests",
                "where": {
                  "id": "{{params.id}}"
                },
                "limit": 1,
                "storeAs": "leaveRequest"
              }
            },
            {
              "type": "conditional",
              "conditional": {
                "condition": {
                  "field": "leaveRequest.status",
                  "operator": "not_equals",
                  "value": "pending"
                },
                "then": [
                  {
                    "type": "return_error",
                    "return_error": {
                      "message": "Only pending leave requests can be approved",
                      "code": 400
                    }
                  }
                ]
              }
            },
            {
              "type": "db_query",
              "db_query": {
                "action": "update",
                "table": "leaveRequests",
                "where": {
                  "id": "{{params.id}}"
                },
                "data": {
                  "status": "approved",
                  "approvedBy": "{{user.id}}",
                  "approvedAt": "{{new Date().toISOString()}}",
                  "updatedAt": "{{new Date().toISOString()}}"
                },
                "storeAs": "updatedRequest"
              }
            },
            {
              "type": "return_response",
              "return_response": {
                "data": "updatedRequest"
              }
            }
          ]
        }
      },
      {
        "path": "/:id/reject",
        "method": "POST",
        "description": "Reject a leave request",
        "validation": {
          "fields": {
            "rejectionReason": {
              "type": "string",
              "min": 10
            }
          }
        },
        "workflow": {
          "steps": [
            {
              "type": "check_exists",
              "check_exists": {
                "table": "leaveRequests",
                "where": {
                  "id": "{{params.id}}"
                },
                "onNotExists": "return_error",
                "error": {
                  "message": "Leave request not found",
                  "code": 404
                }
              }
            },
            {
              "type": "db_query",
              "db_query": {
                "action": "select",
                "table": "leaveRequests",
                "where": {
                  "id": "{{params.id}}"
                },
                "limit": 1,
                "storeAs": "leaveRequest"
              }
            },
            {
              "type": "conditional",
              "conditional": {
                "condition": {
                  "field": "leaveRequest.status",
                  "operator": "not_equals",
                  "value": "pending"
                },
                "then": [
                  {
                    "type": "return_error",
                    "return_error": {
                      "message": "Only pending leave requests can be rejected",
                      "code": 400
                    }
                  }
                ]
              }
            },
            {
              "type": "db_query",
              "db_query": {
                "action": "update",
                "table": "leaveRequests",
                "where": {
                  "id": "{{params.id}}"
                },
                "data": {
                  "status": "rejected",
                  "approvedBy": "{{user.id}}",
                  "rejectionReason": "{{body.rejectionReason}}",
                  "rejectedAt": "{{new Date().toISOString()}}",
                  "updatedAt": "{{new Date().toISOString()}}"
                },
                "storeAs": "updatedRequest"
              }
            },
            {
              "type": "return_response",
              "return_response": {
                "data": "updatedRequest"
              }
            }
          ]
        }
      }
    ]
  }
}
