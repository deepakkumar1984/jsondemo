{
  "resource": "employeeDocuments",
  "basePath": "/api/employee-documents",
  "description": "Employee document management API",
  "table": "employeeDocuments",
  "auth": {
    "required": true
  },
  "operations": {
    "list": {
      "enabled": true,
      "filters": [
        {
          "field": "employeeId",
          "operator": "equals",
          "queryParam": "employeeId"
        },
        {
          "field": "type",
          "operator": "equals",
          "queryParam": "type"
        }
      ],
      "sort": {
        "default": "uploadedAt",
        "defaultOrder": "desc",
        "allowed": ["uploadedAt", "name", "type"]
      },
      "pagination": {
        "enabled": true,
        "defaultLimit": 50,
        "maxLimit": 100
      },
      "relations": [
        {
          "name": "employee",
          "table": "employees",
          "foreignKey": "employeeId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "getById": {
      "enabled": true,
      "idField": "id",
      "relations": [
        {
          "name": "employee",
          "table": "employees",
          "foreignKey": "employeeId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "create": {
      "enabled": true,
      "validation": {
        "required": ["employeeId", "name", "type", "fileUrl"],
        "fields": {
          "name": {
            "type": "string",
            "min": 1,
            "max": 255
          },
          "type": {
            "type": "string",
            "enum": ["resume", "offer-letter", "id-proof", "address-proof", "certificate", "other"]
          },
          "fileUrl": {
            "type": "url"
          }
        }
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "check_exists",
            "check_exists": {
              "table": "employees",
              "where": {
                "id": "{{body.employeeId}}"
              },
              "onNotExists": "return_error",
              "error": {
                "message": "Employee not found",
                "code": 404
              }
            }
          }
        ]
      }
    },
    "update": {
      "enabled": true,
      "idField": "id",
      "validation": {
        "fields": {
          "name": {
            "type": "string",
            "min": 1,
            "max": 255
          },
          "type": {
            "type": "string",
            "enum": ["resume", "offer-letter", "id-proof", "address-proof", "certificate", "other"]
          },
          "fileUrl": {
            "type": "url"
          }
        }
      }
    },
    "delete": {
      "enabled": true,
      "idField": "id",
      "softDelete": {
        "enabled": false
      }
    }
  }
}
