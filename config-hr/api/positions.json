{
  "resource": "positions",
  "basePath": "/api/positions",
  "description": "Job position management API with CRUD operations",
  "table": "positions",
  "auth": {
    "required": true
  },
  "operations": {
    "list": {
      "enabled": true,
      "filters": [
        {
          "field": "departmentId",
          "operator": "equals",
          "queryParam": "departmentId"
        }
      ],
      "sort": {
        "default": "title",
        "defaultOrder": "asc",
        "allowed": ["title", "code", "level", "createdAt"]
      },
      "pagination": {
        "enabled": false
      },
      "relations": [
        {
          "name": "department",
          "table": "departments",
          "foreignKey": "departmentId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "getById": {
      "enabled": true,
      "idField": "id",
      "relations": [
        {
          "name": "department",
          "table": "departments",
          "foreignKey": "departmentId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "create": {
      "enabled": true,
      "validation": {
        "required": ["title", "code"],
        "fields": {
          "title": {
            "type": "string",
            "min": 2,
            "max": 255
          },
          "code": {
            "type": "string",
            "min": 2,
            "max": 50
          },
          "minSalary": {
            "type": "number",
            "min": 0
          },
          "maxSalary": {
            "type": "number",
            "min": 0
          }
        }
      },
      "defaults": {
        "active": 1
      }
    },
    "update": {
      "enabled": true,
      "idField": "id",
      "validation": {
        "fields": {
          "title": {
            "type": "string",
            "min": 2,
            "max": 255
          },
          "code": {
            "type": "string",
            "min": 2,
            "max": 50
          },
          "minSalary": {
            "type": "number",
            "min": 0
          },
          "maxSalary": {
            "type": "number",
            "min": 0
          }
        }
      }
    },
    "delete": {
      "enabled": true,
      "idField": "id",
      "softDelete": {
        "enabled": false
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "db_query",
            "db_query": {
              "action": "count",
              "table": "employees",
              "where": {
                "positionId": "{{params.id}}"
              },
              "storeAs": "employeeCount"
            }
          },
          {
            "type": "conditional",
            "conditional": {
              "condition": "employeeCount > 0",
              "then": [
                {
                  "type": "return_error",
                  "return_error": {
                    "message": "Cannot delete position: {{employeeCount}} employee(s) are still assigned to this position",
                    "code": 400
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
