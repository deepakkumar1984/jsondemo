{
  "resource": "performanceReviews",
  "basePath": "/api/performance-reviews",
  "description": "Employee performance review management API",
  "table": "performanceReviews",
  "auth": {
    "required": true
  },
  "operations": {
    "list": {
      "enabled": true,
      "filters": [
        {
          "field": "employeeId",
          "operator": "equals",
          "queryParam": "employeeId"
        },
        {
          "field": "reviewerId",
          "operator": "equals",
          "queryParam": "reviewerId"
        },
        {
          "field": "status",
          "operator": "equals",
          "queryParam": "status"
        }
      ],
      "sort": {
        "default": "reviewDate",
        "defaultOrder": "desc",
        "allowed": ["reviewDate", "period", "rating", "status"]
      },
      "pagination": {
        "enabled": true,
        "defaultLimit": 50,
        "maxLimit": 100
      },
      "relations": [
        {
          "name": "employee",
          "table": "employees",
          "foreignKey": "employeeId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "reviewer",
          "table": "employees",
          "foreignKey": "reviewerId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "getById": {
      "enabled": true,
      "idField": "id",
      "relations": [
        {
          "name": "employee",
          "table": "employees",
          "foreignKey": "employeeId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "reviewer",
          "table": "employees",
          "foreignKey": "reviewerId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "create": {
      "enabled": true,
      "validation": {
        "required": ["employeeId", "reviewerId", "period"],
        "fields": {
          "period": {
            "type": "string",
            "min": 3,
            "max": 50
          },
          "rating": {
            "type": "number",
            "min": 1,
            "max": 5
          },
          "status": {
            "type": "string",
            "enum": ["draft", "submitted", "completed"]
          }
        }
      },
      "defaults": {
        "status": "draft"
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "check_exists",
            "check_exists": {
              "table": "employees",
              "where": {
                "id": "{{body.employeeId}}"
              },
              "onNotExists": "return_error",
              "error": {
                "message": "Employee not found",
                "code": 404
              }
            }
          },
          {
            "type": "check_exists",
            "check_exists": {
              "table": "employees",
              "where": {
                "id": "{{body.reviewerId}}"
              },
              "onNotExists": "return_error",
              "error": {
                "message": "Reviewer not found",
                "code": 404
              }
            }
          }
        ]
      }
    },
    "update": {
      "enabled": true,
      "idField": "id",
      "validation": {
        "fields": {
          "period": {
            "type": "string",
            "min": 3,
            "max": 50
          },
          "rating": {
            "type": "number",
            "min": 1,
            "max": 5
          },
          "status": {
            "type": "string",
            "enum": ["draft", "submitted", "completed"]
          }
        }
      }
    },
    "delete": {
      "enabled": true,
      "idField": "id",
      "softDelete": {
        "enabled": false
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "db_query",
            "db_query": {
              "action": "select",
              "table": "performanceReviews",
              "where": {
                "id": "{{params.id}}"
              },
              "limit": 1,
              "storeAs": "review"
            }
          },
          {
            "type": "conditional",
            "conditional": {
              "condition": {
                "field": "review.status",
                "operator": "equals",
                "value": "completed"
              },
              "then": [
                {
                  "type": "return_error",
                  "return_error": {
                    "message": "Cannot delete a completed performance review",
                    "code": 400
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
