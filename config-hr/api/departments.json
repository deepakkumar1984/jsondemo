{
  "resource": "departments",
  "basePath": "/api/departments",
  "description": "Department management API with CRUD operations",
  "table": "departments",
  "auth": {
    "required": true
  },
  "operations": {
    "list": {
      "enabled": true,
      "sort": {
        "default": "name",
        "defaultOrder": "asc",
        "allowed": ["name", "code", "createdAt"]
      },
      "pagination": {
        "enabled": false
      }
    },
    "getById": {
      "enabled": true,
      "idField": "id"
    },
    "create": {
      "enabled": true,
      "validation": {
        "required": ["name", "code"],
        "fields": {
          "name": {
            "type": "string",
            "min": 2,
            "max": 255
          },
          "code": {
            "type": "string",
            "min": 2,
            "max": 50
          }
        }
      },
      "defaults": {
        "active": 1
      }
    },
    "update": {
      "enabled": true,
      "idField": "id",
      "validation": {
        "fields": {
          "name": {
            "type": "string",
            "min": 2,
            "max": 255
          },
          "code": {
            "type": "string",
            "min": 2,
            "max": 50
          }
        }
      }
    },
    "delete": {
      "enabled": true,
      "idField": "id",
      "softDelete": {
        "enabled": false
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "db_query",
            "db_query": {
              "action": "count",
              "table": "employees",
              "where": {
                "departmentId": "{{params.id}}"
              },
              "storeAs": "employeeCount"
            }
          },
          {
            "type": "conditional",
            "conditional": {
              "condition": "employeeCount > 0",
              "then": [
                {
                  "type": "return_error",
                  "return_error": {
                    "message": "Cannot delete department: {{employeeCount}} employee(s) are still assigned to this department",
                    "code": 400
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
