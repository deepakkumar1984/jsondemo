{
  "resource": "projects",
  "name": "Projects API",
  "version": "v1",
  "basePath": "/api/projects",
  "description": "Project management endpoints with budget tracking",
  "auth": {
    "required": true,
    "type": "JWT",
    "roles": ["user", "admin"]
  },
  "operations": [
    {
      "id": "createProject",
      "method": "POST",
      "path": "/",
      "description": "Create a new project with budget calculation",
      "requestSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "clientName": { "type": "string" },
          "status": { "type": "string" },
          "priority": { "type": "string" },
          "budgetHours": { "type": "number" },
          "hourlyRate": { "type": "number" },
          "deadline": { "type": "string" }
        },
        "required": ["name", "budgetHours", "hourlyRate"]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "totalBudget": { "type": "number" },
          "status": { "type": "string" }
        }
      },
      "actions": [
        {
          "type": "validate",
          "rules": [
            { "field": "budgetHours", "rule": "min", "value": 1 },
            { "field": "hourlyRate", "rule": "min", "value": 0 }
          ]
        },
        {
          "type": "transform",
          "set": {
            "body.client_name": "{{body.clientName}}",
            "body.budget_hours": "{{body.budgetHours}}",
            "body.hourly_rate": "{{body.hourlyRate}}",
            "body.status": "{{body.status}}",
            "body.priority": "{{body.priority}}",
            "body.created_at": "now()",
            "body.updated_at": "now()"
          }
        },
        {
          "type": "condition",
          "if": "{{body.status == null || body.status == ''}}",
          "then": [
            {
              "type": "transform",
              "set": {
                "body.status": "planning"
              }
            }
          ]
        },
        {
          "type": "condition",
          "if": "{{body.priority == null || body.priority == ''}}",
          "then": [
            {
              "type": "transform",
              "set": {
                "body.priority": "medium"
              }
            }
          ]
        },
        {
          "type": "calc",
          "set": {
            "body.total_budget": "{{body.budget_hours}} * {{body.hourly_rate}}"
          }
        },
        {
          "type": "db.insert",
          "table": "projects",
          "map": {
            "id": "uuid()",
            "name": "{{body.name}}",
            "description": "{{body.description}}",
            "client_name": "{{body.client_name}}",
            "status": "{{body.status}}",
            "priority": "{{body.priority}}",
            "budget_hours": "{{body.budget_hours}}",
            "hourly_rate": "{{body.hourly_rate}}",
            "total_budget": "{{body.total_budget}}",
            "deadline": "{{body.deadline}}",
            "created_at": "{{body.created_at}}",
            "updated_at": "{{body.updated_at}}"
          },
          "returning": "projectId"
        },
        {
          "type": "response.map",
          "fields": {
            "id": "{{projectId}}",
            "name": "{{body.name}}",
            "totalBudget": "{{body.total_budget}}",
            "status": "{{body.status}}"
          }
        }
      ]
    },
    {
      "id": "getDashboardStats",
      "method": "GET",
      "path": "/dashboard/stats",
      "description": "Get dashboard statistics",
      "responseSchema": {
        "type": "object",
        "properties": {
          "projects": { "type": "object" },
          "timeTracking": { "type": "object" }
        }
      },
      "actions": [
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "deleted_at": null
          },
          "into": "allProjects"
        },
        {
          "type": "db.query",
          "table": "time_entries",
          "into": "allTimeEntries"
        },
        {
          "type": "calc",
          "set": {
            "totalProjects": "{{allProjects.length}}",
            "totalHours": "sum(allTimeEntries, 'hours')",
            "totalRevenue": "sum(allTimeEntries, 'cost')"
          }
        },
        {
          "type": "response.map",
          "fields": {
            "projects": {
              "total": "{{totalProjects}}",
              "active": "{{totalProjects}}"
            },
            "timeTracking": {
              "totalHours": "{{totalHours}}",
              "totalRevenue": "{{totalRevenue}}"
            }
          }
        }
      ]
    },
    {
      "id": "listProjects",
      "method": "GET",
      "path": "/",
      "description": "Get all projects",
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "actions": [
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "deleted_at": null
          },
          "into": "projectsRaw"
        },
        {
          "type": "transform.array",
          "from": "projectsRaw",
          "fieldMap": {
            "clientName": "client_name",
            "budgetHours": "budget_hours",
            "hourlyRate": "hourly_rate",
            "totalBudget": "total_budget",
            "startedAt": "started_at",
            "completedAt": "completed_at",
            "createdAt": "created_at",
            "updatedAt": "updated_at",
            "deletedAt": "deleted_at"
          }
        }
      ]
    },
    {
      "id": "getProjectById",
      "method": "GET",
      "path": "/:id",
      "description": "Get a single project by ID",
      "responseSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "actions": [
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "project"
        },
        {
          "type": "db.query",
          "table": "time_entries",
          "where": {
            "project_id": "{{params.id}}"
          },
          "into": "timeEntries"
        },
        {
          "type": "calc",
          "set": {
            "totalHours": "sum(timeEntries, 'hours')",
            "totalCost": "sum(timeEntries, 'cost')"
          }
        },
        {
          "type": "calc",
          "set": {
            "remainingHours": "{{project.budget_hours}} - {{totalHours}}",
            "budgetUsedPercentage": "({{totalHours}} / {{project.budget_hours}}) * 100"
          }
        },
        {
          "type": "response.map",
          "fields": {
            "id": "{{project.id}}",
            "name": "{{project.name}}",
            "description": "{{project.description}}",
            "clientName": "{{project.client_name}}",
            "status": "{{project.status}}",
            "priority": "{{project.priority}}",
            "budgetHours": "{{project.budget_hours}}",
            "hourlyRate": "{{project.hourly_rate}}",
            "totalBudget": "{{project.total_budget}}",
            "totalHours": "{{totalHours}}",
            "totalCost": "{{totalCost}}",
            "remainingHours": "{{remainingHours}}",
            "budgetUsedPercentage": "{{budgetUsedPercentage}}",
            "deadline": "{{project.deadline}}",
            "createdAt": "{{project.created_at}}",
            "updatedAt": "{{project.updated_at}}"
          }
        }
      ]
    },
    {
      "id": "updateProject",
      "method": "PUT",
      "path": "/:id",
      "description": "Update an existing project",
      "requestSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "clientName": { "type": "string" },
          "status": { "type": "string" },
          "priority": { "type": "string" },
          "budgetHours": { "type": "number" },
          "hourlyRate": { "type": "number" },
          "deadline": { "type": "string" }
        }
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "totalBudget": { "type": "number" }
        }
      },
      "actions": [
        {
          "type": "transform",
          "set": {
            "updateData.client_name": "{{body.clientName}}",
            "updateData.budget_hours": "{{body.budgetHours}}",
            "updateData.hourly_rate": "{{body.hourlyRate}}",
            "updateData.updated_at": "now()"
          }
        },
        {
          "type": "calc",
          "set": {
            "updateData.total_budget": "{{updateData.budget_hours}} * {{updateData.hourly_rate}}"
          }
        },
        {
          "type": "db.update",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "map": {
            "name": "{{body.name}}",
            "description": "{{body.description}}",
            "client_name": "{{updateData.client_name}}",
            "status": "{{body.status}}",
            "priority": "{{body.priority}}",
            "budget_hours": "{{updateData.budget_hours}}",
            "hourly_rate": "{{updateData.hourly_rate}}",
            "total_budget": "{{updateData.total_budget}}",
            "deadline": "{{body.deadline}}",
            "updated_at": "{{updateData.updated_at}}"
          }
        },
        {
          "type": "response.map",
          "fields": {
            "id": "{{params.id}}",
            "name": "{{body.name}}",
            "totalBudget": "{{updateData.total_budget}}"
          }
        }
      ]
    },
    {
      "id": "deleteProject",
      "method": "DELETE",
      "path": "/:id",
      "description": "Soft delete a project",
      "responseSchema": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "actions": [
        {
          "type": "db.update",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "map": {
            "deleted_at": "now()"
          }
        },
        {
          "type": "response.map",
          "fields": {
            "message": "Project deleted successfully"
          }
        }
      ]
    },
    {
      "id": "getProjectTimeEntries",
      "method": "GET",
      "path": "/:id/time-entries",
      "description": "Get all time entries for a project",
      "responseSchema": {
        "type": "object",
        "properties": {
          "entries": { "type": "array" },
          "statistics": { "type": "object" }
        }
      },
      "actions": [
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "project"
        },
        {
          "type": "condition",
          "if": "{{project == null}}",
          "then": [
            {
              "type": "response.map",
              "fields": {
                "error": "Project not found"
              }
            }
          ]
        },
        {
          "type": "db.query",
          "table": "time_entries",
          "where": {
            "project_id": "{{params.id}}"
          },
          "into": "entries"
        },
        {
          "type": "calc",
          "set": {
            "totalHours": "sum(entries, 'hours')"
          }
        },
        {
          "type": "response.map",
          "fields": {
            "entries": "{{entries}}",
            "statistics": {
              "totalEntries": "{{entries.length}}",
              "totalHours": "{{totalHours}}"
            }
          }
        }
      ]
    },
    {
      "id": "createProjectTimeEntry",
      "method": "POST",
      "path": "/:id/time-entries",
      "description": "Add a time entry to a project",
      "requestSchema": {
        "type": "object",
        "properties": {
          "hours": { "type": "number" },
          "description": { "type": "string" },
          "date": { "type": "string" }
        },
        "required": ["hours", "description", "date"]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "entry": { "type": "object" }
        }
      },
      "actions": [
        {
          "type": "validate",
          "rules": [
            { "field": "hours", "rule": "min", "value": 0.25 },
            { "field": "hours", "rule": "max", "value": 24 }
          ]
        },
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "project"
        },
        {
          "type": "condition",
          "if": "{{project == null}}",
          "then": [
            {
              "type": "response.map",
              "fields": {
                "error": "Project not found"
              }
            }
          ]
        },
        {
          "type": "calc",
          "set": {
            "cost": "{{body.hours}} * {{project.hourly_rate}}"
          }
        },
        {
          "type": "db.insert",
          "table": "time_entries",
          "map": {
            "id": "uuid()",
            "project_id": "{{params.id}}",
            "user_id": "{{user.sub}}",
            "hours": "{{body.hours}}",
            "description": "{{body.description}}",
            "date": "{{body.date}}",
            "hourly_rate": "{{project.hourly_rate}}",
            "cost": "{{cost}}",
            "billable": true,
            "created_at": "now()",
            "updated_at": "now()"
          },
          "returning": "entryId"
        },
        {
          "type": "response.map",
          "fields": {
            "id": "{{entryId}}",
            "projectId": "{{params.id}}",
            "hours": "{{body.hours}}",
            "description": "{{body.description}}",
            "date": "{{body.date}}"
          }
        }
      ]
    }
  ]
}
