{
  "resource": "projects",
  "name": "Projects API",
  "basePath": "/api/projects",
  "description": "Project management with CRUD operations, filtering, and archival",
  "operations": [
    {
      "id": "createProject",
      "name": "Create Project",
      "method": "POST",
      "path": "/",
      "description": "Create a new project with name uniqueness validation",
      "requestSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Archived"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "requiresAuth": true,
      "actions": [
        {
          "type": "validate",
          "rules": [
            {
              "field": "body.name",
              "rule": "required",
              "message": "Project name is required"
            },
            {
              "field": "body.name",
              "rule": "min",
              "value": 1
            },
            {
              "field": "body.name",
              "rule": "max",
              "value": 255
            },
            {
              "field": "body.description",
              "rule": "max",
              "value": 2000
            }
          ]
        },
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "name": "{{body.name}}",
            "owner_user_id": "{{user.id}}"
          },
          "limit": 1,
          "into": "existingProject",
          "description": "Check for duplicate project name within user's workspace"
        },
        {
          "type": "condition",
          "if": "{{existingProject}} != null",
          "then": [
            {
              "type": "response.map",
              "status": 409,
              "fields": {
                "error": "A project with this name already exists in your workspace"
              }
            }
          ]
        },
        {
          "type": "transform",
          "set": {
            "body.id": "uuid()",
            "body.ownerUserId": "{{user.id}}",
            "body.status": "{{body.status || 'Active'}}",
            "body.createdAt": "now()",
            "body.updatedAt": "now()"
          }
        },
        {
          "type": "db.insert",
          "table": "projects",
          "map": {
            "id": "{{body.id}}",
            "name": "{{body.name}}",
            "description": "{{body.description}}",
            "status": "{{body.status}}",
            "owner_user_id": "{{body.ownerUserId}}",
            "created_at": "{{body.createdAt}}",
            "updated_at": "{{body.updatedAt}}"
          },
          "returning": "projectId"
        },
        {
          "type": "response.map",
          "status": 201,
          "fields": {
            "id": "{{body.id}}",
            "name": "{{body.name}}",
            "message": "Project created successfully"
          }
        }
      ]
    },
    {
      "id": "getProjectById",
      "name": "Get Project by ID",
      "method": "GET",
      "path": "/:id",
      "description": "Retrieve a single project by ID",
      "requestSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "requiresAuth": true,
      "actions": [
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "project"
        },
        {
          "type": "condition",
          "if": "{{project}} == null",
          "then": [
            {
              "type": "response.map",
              "status": 404,
              "fields": {
                "error": "Project not found"
              }
            }
          ]
        },
        {
          "type": "response.map",
          "fields": {
            "id": "{{project.id}}",
            "name": "{{project.name}}",
            "description": "{{project.description}}",
            "status": "{{project.status}}",
            "ownerUserId": "{{project.owner_user_id}}",
            "createdAt": "{{project.created_at}}",
            "updatedAt": "{{project.updated_at}}"
          }
        }
      ]
    },
    {
      "id": "updateProject",
      "name": "Update Project",
      "method": "PUT",
      "path": "/:id",
      "description": "Update project details with name uniqueness validation",
      "requestSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Archived"
            ]
          }
        }
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "requiresAuth": true,
      "actions": [
        {
          "type": "validate",
          "rules": [
            {
              "field": "body.name",
              "rule": "min",
              "value": 1
            },
            {
              "field": "body.name",
              "rule": "max",
              "value": 255
            },
            {
              "field": "body.description",
              "rule": "max",
              "value": 2000
            }
          ]
        },
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "existingProject"
        },
        {
          "type": "condition",
          "if": "{{existingProject}} == null",
          "then": [
            {
              "type": "response.map",
              "status": 404,
              "fields": {
                "error": "Project not found"
              }
            }
          ]
        },
        {
          "type": "condition",
          "if": "{{body.name}} != null && {{body.name}} != {{existingProject.name}}",
          "then": [
            {
              "type": "db.query",
              "table": "projects",
              "where": {
                "name": "{{body.name}}",
                "owner_user_id": "{{existingProject.owner_user_id}}"
              },
              "limit": 1,
              "into": "duplicateProject"
            },
            {
              "type": "condition",
              "if": "{{duplicateProject}} != null",
              "then": [
                {
                  "type": "response.map",
                  "status": 409,
                  "fields": {
                    "error": "A project with this name already exists in your workspace"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "transform",
          "set": {
            "body.updatedAt": "now()"
          }
        },
        {
          "type": "db.update",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "map": {
            "name": "{{body.name}}",
            "description": "{{body.description}}",
            "status": "{{body.status}}",
            "updated_at": "{{body.updatedAt}}"
          },
          "returning": "id"
        },
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "updatedProject"
        },
        {
          "type": "response.map",
          "fields": {
            "id": "{{updatedProject.id}}",
            "name": "{{updatedProject.name}}",
            "description": "{{updatedProject.description}}",
            "status": "{{updatedProject.status}}",
            "ownerUserId": "{{updatedProject.owner_user_id}}",
            "updatedAt": "{{updatedProject.updated_at}}",
            "message": "Project updated successfully"
          }
        }
      ]
    },
    {
      "id": "archiveProject",
      "name": "Archive Project",
      "method": "PUT",
      "path": "/:id/archive",
      "description": "Archive a project by setting status to Archived",
      "requestSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "requiresAuth": true,
      "actions": [
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "project"
        },
        {
          "type": "condition",
          "if": "{{project}} == null",
          "then": [
            {
              "type": "response.map",
              "status": 404,
              "fields": {
                "error": "Project not found"
              }
            }
          ]
        },
        {
          "type": "transform",
          "set": {
            "body.updatedAt": "now()",
            "body.status": "Archived"
          }
        },
        {
          "type": "db.update",
          "table": "projects",
          "where": {
            "id": "{{params.id}}"
          },
          "map": {
            "status": "{{body.status}}",
            "updated_at": "{{body.updatedAt}}"
          },
          "returning": "id"
        },
        {
          "type": "response.map",
          "fields": {
            "id": "{{params.id}}",
            "status": "Archived",
            "message": "Project archived successfully"
          }
        }
      ]
    },
    {
      "id": "listProjects",
      "name": "List Projects",
      "method": "GET",
      "path": "/",
      "description": "List projects with filtering by status, owner, and search by name, with sorting options",
      "requestSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Archived"
            ]
          },
          "ownerUserId": {
            "type": "string"
          },
          "searchByName": {
            "type": "string"
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "updatedAt",
              "name"
            ]
          },
          "sortOrder": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        }
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array"
          },
          "total": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        }
      },
      "requiresAuth": true,
      "actions": [
        {
          "type": "transform",
          "set": {
            "query.limit": "{{query.limit || 50}}",
            "query.offset": "{{query.offset || 0}}",
            "query.sortBy": "{{query.sortBy || 'updatedAt'}}",
            "query.sortOrder": "{{query.sortOrder || 'desc'}}"
          }
        },
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "status": "{{query.status}}",
            "owner_user_id": "{{query.ownerUserId}}",
            "name": {
              "_ilike": "{{query.searchByName}}"
            }
          },
          "orderBy": [
            {
              "field": "{{query.sortBy}}",
              "direction": "{{query.sortOrder}}"
            }
          ],
          "limit": "{{query.limit}}",
          "offset": "{{query.offset}}",
          "into": "projects"
        },
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "status": "{{query.status}}",
            "owner_user_id": "{{query.ownerUserId}}",
            "name": {
              "_ilike": "{{query.searchByName}}"
            }
          },
          "select": [
            "COUNT(*) as total"
          ],
          "limit": 1,
          "into": "countResult"
        },
        {
          "type": "response.map",
          "fields": {
            "items": "{{projects}}",
            "total": "{{countResult.total}}",
            "limit": "{{query.limit}}",
            "offset": "{{query.offset}}"
          }
        }
      ]
    }
  ]
}