{
  "resource": "projects",
  "table": "projects",
  "basePath": "/api/projects",
  "list": {
    "enabled": true,
    "defaultLimit": 50,
    "filters": [],
    "search": {
      "fields": [
        "name",
        "description"
      ]
    }
  },
  "getById": {
    "enabled": true,
    "lookups": [
      {
        "name": "owner",
        "condition": "ownerId IS NOT NULL",
        "table": "users",
        "where": {
          "id": "{{ownerId}}"
        },
        "select": [
          "id",
          "name",
          "email"
        ],
        "format": "single"
      }
    ]
  },
  "create": {
    "enabled": true
  },
  "update": {
    "enabled": true
  },
  "delete": {
    "enabled": true,
    "mode": "soft"
  },
  "customEndpoints": [
    {
      "method": "GET",
      "path": "/by-owner/:ownerId",
      "handler": "getProjectsByOwner"
    },
    {
      "method": "GET",
      "path": "/search",
      "handler": "searchProjects"
    }
  ]
}