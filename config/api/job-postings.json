{
  "resource": "job postings",
  "table": "jobPostings",
  "basePath": "/talent/jobs",
  "list": {
    "enabled": true,
    "paginated": true,
    "fields": ["id", "title", "departmentId", "positionId", "description", "requirements", "status", "postedDate", "closingDate"],
    "joins": [
      {
        "table": "departments",
        "on": ["departmentId", "departments.id"],
        "fields": { "departmentName": "name" }
      },
      {
        "table": "positions",
        "on": ["positionId", "positions.id"],
        "fields": { "positionTitle": "title" }
      }
    ],
    "filters": [
      { "param": "status", "field": "status", "cast": "enum" },
      { "param": "departmentId", "field": "departmentId" }
    ]
  },
  "create": {
    "enabled": true,
    "requiredFields": ["title"],
    "fields": ["title", "departmentId", "positionId", "description", "requirements", "status", "postedDate", "closingDate"],
    "defaults": { "status": "draft" }
  }
}
