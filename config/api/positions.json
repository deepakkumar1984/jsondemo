{
  "resource": "positions",
  "table": "positions",
  "basePath": "/positions",
  "list": {
    "enabled": true,
    "paginated": false,
    "orderBy": { "field": "title", "direction": "asc" },
    "fields": ["id", "title", "code", "departmentId", "level", "minSalary", "maxSalary", "active", "createdAt"],
    "joins": [
      {
        "table": "departments",
        "on": ["departmentId", "departments.id"],
        "fields": { "departmentName": "name" }
      }
    ],
    "filters": [
      { "param": "departmentId", "field": "departmentId" }
    ]
  },
  "getById": {
    "enabled": true,
    "fields": ["id", "title", "code", "departmentId", "level", "minSalary", "maxSalary", "active", "createdAt"],
    "joins": [
      {
        "table": "departments",
        "on": ["departmentId", "departments.id"],
        "fields": { "departmentName": "name" }
      }
    ]
  },
  "create": {
    "enabled": true,
    "requiredFields": ["title", "code"],
    "fields": ["title", "code", "departmentId", "level", "minSalary", "maxSalary", "active"],
    "defaults": { "active": 1 },
    "coerce": { "active": "boolean_to_int", "minSalary": "to_number", "maxSalary": "to_number" }
  },
  "update": {
    "enabled": true,
    "fields": ["title", "code", "departmentId", "level", "minSalary", "maxSalary", "active"],
    "coerce": { "active": "boolean_to_int", "minSalary": "to_number", "maxSalary": "to_number" }
  },
  "delete": {
    "enabled": true,
    "mode": "hard",
    "referentialChecks": [
      {
        "table": "employees",
        "foreignKey": "positionId",
        "message": "Cannot delete position: {count} employee(s) are still assigned to this position"
      }
    ]
  }
}
