{
  "resource": "tasks",
  "table": "tasks",
  "basePath": "/api/tasks",
  "list": {
    "enabled": true,
    "defaultLimit": 50,
    "filters": [
      {
        "param": "status",
        "field": "status",
        "cast": "text"
      },
      {
        "param": "priority",
        "field": "priority",
        "cast": "text"
      }
    ],
    "search": {
      "fields": [
        "title",
        "description"
      ]
    }
  },
  "getById": {
    "enabled": true,
    "lookups": [
      {
        "name": "project",
        "condition": "projectId IS NOT NULL",
        "table": "projects",
        "where": {
          "id": "{{projectId}}"
        },
        "select": [
          "id",
          "name",
          "ownerId"
        ],
        "format": "single"
      },
      {
        "name": "assignee",
        "condition": "assigneeId IS NOT NULL",
        "table": "users",
        "where": {
          "id": "{{assigneeId}}"
        },
        "select": [
          "id",
          "name",
          "email"
        ],
        "format": "single"
      },
      {
        "name": "creator",
        "condition": "createdById IS NOT NULL",
        "table": "users",
        "where": {
          "id": "{{createdById}}"
        },
        "select": [
          "id",
          "name",
          "email"
        ],
        "format": "single"
      }
    ]
  },
  "create": {
    "enabled": true
  },
  "update": {
    "enabled": true
  },
  "delete": {
    "enabled": true,
    "mode": "soft"
  },
  "customEndpoints": [
    {
      "method": "GET",
      "path": "/by-status/:status",
      "handler": "getTasksByStatus"
    },
    {
      "method": "GET",
      "path": "/search",
      "handler": "searchTasks"
    }
  ]
}