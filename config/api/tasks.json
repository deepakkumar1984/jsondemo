{
  "resource": "tasks",
  "name": "Task Management API with Status Transition Rules",
  "basePath": "/api/tasks",
  "description": "Task management with lifecycle rules, status transitions, and derived field behavior",
  "operations": [
    {
      "id": "createTask",
      "name": "Create Task",
      "method": "POST",
      "path": "/",
      "description": "Create a new task with validation rules and activity logging",
      "requestSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Backlog",
              "Todo",
              "InProgress",
              "Blocked",
              "Done"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High",
              "Urgent"
            ]
          },
          "assigneeUserId": {
            "type": "string"
          },
          "dueDate": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "estimatePoints": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "projectId",
          "title"
        ]
      },
      "requiresAuth": true,
      "actions": [
        {
          "type": "validate",
          "rules": [
            {
              "field": "body.projectId",
              "rule": "required",
              "message": "Project ID is required"
            },
            {
              "field": "body.title",
              "rule": "required",
              "message": "Task title is required"
            },
            {
              "field": "body.title",
              "rule": "min",
              "value": 1
            },
            {
              "field": "body.title",
              "rule": "max",
              "value": 500
            },
            {
              "field": "body.estimatePoints",
              "rule": "min",
              "value": 0,
              "message": "Estimate points must be >= 0"
            }
          ]
        },
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "id": "{{body.projectId}}"
          },
          "limit": 1,
          "into": "project",
          "description": "Verify project exists"
        },
        {
          "type": "condition",
          "if": "{{project}} == null",
          "then": [
            {
              "type": "response.map",
              "status": 404,
              "fields": {
                "error": "Project not found"
              }
            }
          ]
        },
        {
          "type": "condition",
          "if": "{{body.startDate}} != null && {{body.dueDate}} != null && {{body.startDate}} > {{body.dueDate}}",
          "then": [
            {
              "type": "response.map",
              "status": 400,
              "fields": {
                "error": "Start date cannot be after due date"
              }
            }
          ]
        },
        {
          "type": "transform",
          "set": {
            "body.id": "uuid()",
            "body.reporterUserId": "{{user.id}}",
            "body.createdAt": "now()",
            "body.updatedAt": "now()",
            "body.status": "{{body.status || 'Todo'}}",
            "body.priority": "{{body.priority || 'Medium'}}"
          }
        },
        {
          "type": "condition",
          "if": "{{body.status}} == 'Done'",
          "then": [
            {
              "type": "transform",
              "set": {
                "body.completedAt": "now()"
              }
            }
          ]
        },
        {
          "type": "transaction",
          "actions": [
            {
              "type": "db.insert",
              "table": "tasks",
              "map": {
                "id": "{{body.id}}",
                "project_id": "{{body.projectId}}",
                "title": "{{body.title}}",
                "description": "{{body.description}}",
                "status": "{{body.status}}",
                "priority": "{{body.priority}}",
                "assignee_user_id": "{{body.assigneeUserId}}",
                "reporter_user_id": "{{body.reporterUserId}}",
                "due_date": "{{body.dueDate}}",
                "start_date": "{{body.startDate}}",
                "completed_at": "{{body.completedAt}}",
                "estimate_points": "{{body.estimatePoints}}",
                "tags": "{{body.tags}}",
                "created_at": "{{body.createdAt}}",
                "updated_at": "{{body.updatedAt}}"
              },
              "returning": "taskId"
            },
            {
              "type": "db.insert",
              "table": "task_activities",
              "map": {
                "id": "uuid()",
                "task_id": "{{body.id}}",
                "actor_user_id": "{{user.id}}",
                "event_type": "Created",
                "to_value": "{{body}}",
                "created_at": "now()"
              }
            }
          ]
        },
        {
          "type": "response.map",
          "status": 201,
          "fields": {
            "id": "{{body.id}}",
            "message": "Task created successfully"
          }
        }
      ]
    },
    {
      "id": "getTask",
      "name": "Get Task",
      "method": "GET",
      "path": "/:id",
      "description": "Retrieve a single task with project details",
      "requiresAuth": true,
      "actions": [
        {
          "type": "db.query",
          "table": "tasks",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "task"
        },
        {
          "type": "condition",
          "if": "{{task}} == null",
          "then": [
            {
              "type": "response.map",
              "status": 404,
              "fields": {
                "error": "Task not found"
              }
            }
          ]
        },
        {
          "type": "db.query",
          "table": "projects",
          "where": {
            "id": "{{task.project_id}}"
          },
          "limit": 1,
          "into": "project"
        },
        {
          "type": "response.map",
          "fields": {
            "id": "{{task.id}}",
            "projectId": "{{task.project_id}}",
            "projectName": "{{project.name}}",
            "title": "{{task.title}}",
            "description": "{{task.description}}",
            "status": "{{task.status}}",
            "priority": "{{task.priority}}",
            "assigneeUserId": "{{task.assignee_user_id}}",
            "reporterUserId": "{{task.reporter_user_id}}",
            "dueDate": "{{task.due_date}}",
            "startDate": "{{task.start_date}}",
            "completedAt": "{{task.completed_at}}",
            "estimatePoints": "{{task.estimate_points}}",
            "tags": "{{task.tags}}",
            "createdAt": "{{task.created_at}}",
            "updatedAt": "{{task.updated_at}}"
          }
        }
      ]
    },
    {
      "id": "updateTask",
      "name": "Update Task",
      "method": "PUT",
      "path": "/:id",
      "description": "Update task with status transition rules and derived field behavior",
      "requestSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Backlog",
              "Todo",
              "InProgress",
              "Blocked",
              "Done"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High",
              "Urgent"
            ]
          },
          "assigneeUserId": {
            "type": "string"
          },
          "dueDate": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "estimatePoints": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "requiresAuth": true,
      "actions": [
        {
          "type": "validate",
          "rules": [
            {
              "field": "body.title",
              "rule": "min",
              "value": 1
            },
            {
              "field": "body.title",
              "rule": "max",
              "value": 500
            },
            {
              "field": "body.estimatePoints",
              "rule": "min",
              "value": 0,
              "message": "Estimate points must be >= 0"
            }
          ]
        },
        {
          "type": "db.query",
          "table": "tasks",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "existingTask"
        },
        {
          "type": "condition",
          "if": "{{existingTask}} == null",
          "then": [
            {
              "type": "response.map",
              "status": 404,
              "fields": {
                "error": "Task not found"
              }
            }
          ]
        },
        {
          "type": "transform",
          "set": {
            "finalStartDate": "{{body.startDate || existingTask.start_date}}",
            "finalDueDate": "{{body.dueDate || existingTask.due_date}}"
          }
        },
        {
          "type": "condition",
          "if": "{{finalStartDate}} != null && {{finalDueDate}} != null && {{finalStartDate}} > {{finalDueDate}}",
          "then": [
            {
              "type": "response.map",
              "status": 400,
              "fields": {
                "error": "Start date cannot be after due date"
              }
            }
          ]
        },
        {
          "type": "transform",
          "set": {
            "body.updatedAt": "now()",
            "statusChanged": "{{body.status}} != null && {{body.status}} != {{existingTask.status}}",
            "oldStatus": "{{existingTask.status}}",
            "newStatus": "{{body.status || existingTask.status}}"
          }
        },
        {
          "type": "condition",
          "if": "{{statusChanged}} == true && {{newStatus}} == 'Done'",
          "then": [
            {
              "type": "transform",
              "set": {
                "body.completedAt": "{{existingTask.completed_at || now()}}"
              }
            }
          ]
        },
        {
          "type": "condition",
          "if": "{{statusChanged}} == true && {{oldStatus}} == 'Done' && {{newStatus}} != 'Done'",
          "then": [
            {
              "type": "transform",
              "set": {
                "body.completedAt": null
              }
            }
          ]
        },
        {
          "type": "transaction",
          "actions": [
            {
              "type": "db.update",
              "table": "tasks",
              "where": {
                "id": "{{params.id}}"
              },
              "map": {
                "title": "{{body.title}}",
                "description": "{{body.description}}",
                "status": "{{body.status}}",
                "priority": "{{body.priority}}",
                "assignee_user_id": "{{body.assigneeUserId}}",
                "due_date": "{{body.dueDate}}",
                "start_date": "{{body.startDate}}",
                "completed_at": "{{body.completedAt}}",
                "estimate_points": "{{body.estimatePoints}}",
                "tags": "{{body.tags}}",
                "updated_at": "{{body.updatedAt}}"
              },
              "returning": "id"
            },
            {
              "type": "condition",
              "if": "{{statusChanged}} == true",
              "then": [
                {
                  "type": "db.insert",
                  "table": "task_activities",
                  "map": {
                    "id": "uuid()",
                    "task_id": "{{params.id}}",
                    "actor_user_id": "{{user.id}}",
                    "event_type": "StatusChanged",
                    "from_value": "{{oldStatus}}",
                    "to_value": "{{newStatus}}",
                    "created_at": "now()"
                  }
                }
              ]
            },
            {
              "type": "db.insert",
              "table": "task_activities",
              "map": {
                "id": "uuid()",
                "task_id": "{{params.id}}",
                "actor_user_id": "{{user.id}}",
                "event_type": "Updated",
                "to_value": "{{body}}",
                "created_at": "now()"
              }
            }
          ]
        },
        {
          "type": "response.map",
          "fields": {
            "id": "{{params.id}}",
            "message": "Task updated successfully"
          }
        }
      ]
    },
    {
      "id": "deleteTask",
      "name": "Delete Task",
      "method": "DELETE",
      "path": "/:id",
      "description": "Hard delete task and related activities",
      "requiresAuth": true,
      "actions": [
        {
          "type": "db.query",
          "table": "tasks",
          "where": {
            "id": "{{params.id}}"
          },
          "limit": 1,
          "into": "task"
        },
        {
          "type": "condition",
          "if": "{{task}} == null",
          "then": [
            {
              "type": "response.map",
              "status": 404,
              "fields": {
                "error": "Task not found"
              }
            }
          ]
        },
        {
          "type": "transaction",
          "actions": [
            {
              "type": "db.delete",
              "table": "task_activities",
              "where": {
                "task_id": "{{params.id}}"
              }
            },
            {
              "type": "db.delete",
              "table": "task_comments",
              "where": {
                "task_id": "{{params.id}}"
              }
            },
            {
              "type": "db.delete",
              "table": "tasks",
              "where": {
                "id": "{{params.id}}"
              },
              "returning": "id"
            }
          ]
        },
        {
          "type": "response.map",
          "fields": {
            "message": "Task deleted successfully"
          }
        }
      ]
    },
    {
      "id": "listTasks",
      "name": "List Tasks",
      "method": "GET",
      "path": "/",
      "description": "List tasks with filtering, pagination, and sorting",
      "requestSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "assigneeUserId": {
            "type": "string"
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "sortBy": {
            "type": "string"
          },
          "sortOrder": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        }
      },
      "requiresAuth": true,
      "actions": [
        {
          "type": "transform",
          "set": {
            "query.limit": "{{query.limit || 50}}",
            "query.offset": "{{query.offset || 0}}",
            "query.sortBy": "{{query.sortBy || 'updated_at'}}",
            "query.sortOrder": "{{query.sortOrder || 'desc'}}"
          }
        },
        {
          "type": "db.query",
          "table": "tasks",
          "where": {
            "project_id": "{{query.projectId}}",
            "status": "{{query.status}}",
            "priority": "{{query.priority}}",
            "assignee_user_id": "{{query.assigneeUserId}}"
          },
          "orderBy": {
            "{{query.sortBy}}": "{{query.sortOrder}}"
          },
          "limit": "{{query.limit}}",
          "offset": "{{query.offset}}",
          "into": "tasks"
        },
        {
          "type": "db.query",
          "table": "tasks",
          "where": {
            "project_id": "{{query.projectId}}",
            "status": "{{query.status}}",
            "priority": "{{query.priority}}",
            "assignee_user_id": "{{query.assigneeUserId}}"
          },
          "select": [
            "COUNT(*) as total"
          ],
          "limit": 1,
          "into": "countResult"
        },
        {
          "type": "response.map",
          "fields": {
            "items": "{{tasks}}",
            "total": "{{countResult.total}}",
            "limit": "{{query.limit}}",
            "offset": "{{query.offset}}"
          }
        }
      ]
    },
    {
      "id": "bulkUpdateStatus",
      "name": "Bulk Update Task Status",
      "method": "POST",
      "path": "/bulk-status",
      "description": "Update status for multiple tasks with transition rules and derived field behavior",
      "requestSchema": {
        "type": "object",
        "properties": {
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "Backlog",
              "Todo",
              "InProgress",
              "Blocked",
              "Done"
            ]
          }
        },
        "required": [
          "taskIds",
          "status"
        ]
      },
      "requiresAuth": true,
      "actions": [
        {
          "type": "validate",
          "rules": [
            {
              "field": "body.taskIds",
              "rule": "required",
              "message": "Task IDs are required"
            },
            {
              "field": "body.taskIds",
              "rule": "min",
              "value": 1,
              "message": "At least one task ID is required"
            },
            {
              "field": "body.status",
              "rule": "required",
              "message": "Status is required"
            }
          ]
        },
        {
          "type": "db.query",
          "table": "tasks",
          "where": {
            "id": {
              "_in": "{{body.taskIds}}"
            }
          },
          "into": "tasksToUpdate"
        },
        {
          "type": "condition",
          "if": "{{tasksToUpdate.length}} == 0",
          "then": [
            {
              "type": "response.map",
              "status": 404,
              "fields": {
                "error": "No tasks found with provided IDs"
              }
            }
          ]
        },
        {
          "type": "transform",
          "set": {
            "updatedAt": "now()",
            "completedAt": "{{body.status == 'Done' ? now() : null}}"
          }
        },
        {
          "type": "transaction",
          "actions": [
            {
              "type": "loop",
              "source": "{{tasksToUpdate}}",
              "itemVar": "task",
              "actions": [
                {
                  "type": "transform",
                  "set": {
                    "finalCompletedAt": "{{body.status == 'Done' ? (task.completed_at || now()) : null}}"
                  }
                },
                {
                  "type": "db.update",
                  "table": "tasks",
                  "where": {
                    "id": "{{task.id}}"
                  },
                  "map": {
                    "status": "{{body.status}}",
                    "completed_at": "{{finalCompletedAt}}",
                    "updated_at": "{{updatedAt}}"
                  }
                },
                {
                  "type": "db.insert",
                  "table": "task_activities",
                  "map": {
                    "id": "uuid()",
                    "task_id": "{{task.id}}",
                    "actor_user_id": "{{user.id}}",
                    "event_type": "StatusChanged",
                    "from_value": "{{task.status}}",
                    "to_value": "{{body.status}}",
                    "metadata": {
                      "bulkUpdate": true
                    },
                    "created_at": "now()"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "response.map",
          "fields": {
            "message": "{{tasksToUpdate.length}} tasks updated successfully",
            "updatedCount": "{{tasksToUpdate.length}}",
            "status": "{{body.status}}"
          }
        }
      ]
    }
  ]
}