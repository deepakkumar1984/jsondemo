{
  "dataSources": {
    "tasks": {
      "url": "/tasks"
    },
    "projects": {
      "url": "/projects"
    }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Task List",
        "actions": [
          {
            "label": "Add Task",
            "variant": "primary",
            "action": {
              "type": "navigate",
              "to": "/tasks/new"
            }
          }
        ]
      }
    },
    {
      "type": "DataTable",
      "props": {
        "dataPath": "tasks",
        "columns": [
          {
            "key": "id",
            "header": "ID",
            "sortable": true
          },
          {
            "key": "title",
            "header": "Title",
            "sortable": true
          },
          {
            "key": "status",
            "header": "Status",
            "render": {
              "type": "Badge",
              "props": {
                "valuePath": "status",
                "colorMap": {
                  "open": "blue",
                  "in_progress": "orange",
                  "closed": "green"
                }
              }
            }
          },
          {
            "key": "assigneeUserId",
            "header": "Assignee"
          },
          {
            "key": "priority",
            "header": "Priority"
          },
          {
            "key": "tags",
            "header": "Tags",
            "template": "{{tags}}"
          },
          {
            "key": "dueDate",
            "header": "Due Date",
            "format": "date"
          },
          {
            "key": "actions",
            "header": "Actions",
            "render": {
              "type": "Stack",
              "props": {
                "direction": "horizontal",
                "gap": "sm"
              },
              "children": [
                {
                  "type": "Button",
                  "props": {
                    "label": "View",
                    "variant": "secondary",
                    "size": "sm",
                    "action": {
                      "type": "navigate",
                      "to": "/tasks/{{row.id}}"
                    }
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "label": "Edit",
                    "variant": "secondary",
                    "size": "sm",
                    "action": {
                      "type": "navigate",
                      "to": "/tasks/{{row.id}}/edit"
                    }
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "label": "Delete",
                    "variant": "danger",
                    "size": "sm",
                    "action": {
                      "type": "delete_confirm",
                      "url": "/tasks/{{row.id}}",
                      "message": "Are you sure you want to delete this task?",
                      "redirectTo": "/tasks"
                    }
                  }
                }
              ]
            }
          }
        ],
        "searchable": true,
        "searchPlaceholder": "Search tasks...",
        "paginated": true,
        "pageSize": 10,
        "emptyMessage": "No tasks found.",
        "filters": [
          {
            "key": "projectId",
            "label": "Project",
            "type": "select",
            "optionsPath": "projects",
            "optionLabel": "name",
            "optionValue": "id"
          },
          {
            "key": "status",
            "label": "Status",
            "type": "select",
            "options": [
              {
                "label": "Open",
                "value": "open"
              },
              {
                "label": "In Progress",
                "value": "in_progress"
              },
              {
                "label": "Closed",
                "value": "closed"
              }
            ]
          },
          {
            "key": "assigneeUserId",
            "label": "Assignee",
            "type": "text"
          },
          {
            "key": "priority",
            "label": "Priority",
            "type": "select",
            "options": [
              {
                "label": "Low",
                "value": "low"
              },
              {
                "label": "Medium",
                "value": "medium"
              },
              {
                "label": "High",
                "value": "high"
              }
            ]
          },
          {
            "key": "tag",
            "label": "Tag",
            "type": "text"
          },
          {
            "key": "dueDateFrom",
            "label": "Due Date From",
            "type": "date"
          },
          {
            "key": "dueDateTo",
            "label": "Due Date To",
            "type": "date"
          }
        ]
      }
    }
  ]
}