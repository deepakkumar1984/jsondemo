{
  "dataSources": {
    "department": { "url": "/api/departments/:id" },
    "users": { "url": "/api/employees?status=active" },
    "departments": { "url": "/api/departments" }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Edit Department",
        "subtitle": "Update department information"
      }
    },
    {
      "type": "Form",
      "props": {
        "action": {
          "type": "submit_form",
          "url": "/api/departments/:id",
          "method": "PUT",
          "redirectTo": "/departments"
        }
      },
      "children": [
        {
          "type": "DetailSection",
          "props": {
            "title": "Department Information"
          },
          "children": [
            {
              "type": "Grid",
              "props": {
                "columns": 2,
                "gap": "md"
              },
              "children": [
                {
                  "type": "TextField",
                  "props": {
                    "name": "name",
                    "label": "Department Name",
                    "required": true,
                    "valuePath": "department.name",
                    "placeholder": "e.g. Human Resources"
                  }
                },
                {
                  "type": "TextField",
                  "props": {
                    "name": "code",
                    "label": "Department Code",
                    "required": true,
                    "valuePath": "department.code",
                    "placeholder": "e.g. HR"
                  }
                },
                {
                  "type": "TextArea",
                  "props": {
                    "name": "description",
                    "label": "Description",
                    "valuePath": "department.description",
                    "placeholder": "Enter department description",
                    "rows": 3,
                    "colSpan": 2
                  }
                },
                {
                  "type": "SelectField",
                  "props": {
                    "name": "headId",
                    "label": "Department Head",
                    "valuePath": "department.headId",
                    "optionsPath": "users",
                    "optionLabel": "fullName",
                    "optionValue": "id",
                    "placeholder": "Select department head"
                  }
                },
                {
                  "type": "SelectField",
                  "props": {
                    "name": "parentId",
                    "label": "Parent Department",
                    "valuePath": "department.parentId",
                    "optionsPath": "departments",
                    "optionLabel": "name",
                    "optionValue": "id",
                    "placeholder": "Select parent department (optional)"
                  }
                },
                {
                  "type": "SelectField",
                  "props": {
                    "name": "active",
                    "label": "Active",
                    "required": true,
                    "valuePath": "department.active",
                    "options": [
                      { "label": "Yes", "value": "1" },
                      { "label": "No", "value": "0" }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Divider",
          "props": {}
        },
        {
          "type": "Stack",
          "props": {
            "direction": "horizontal",
            "justify": "flex-end",
            "gap": "md"
          },
          "children": [
            {
              "type": "Button",
              "props": {
                "label": "Cancel",
                "variant": "secondary",
                "action": {
                  "type": "navigate",
                  "to": "/departments"
                }
              }
            },
            {
              "type": "Button",
              "props": {
                "label": "Save Changes",
                "variant": "primary",
                "buttonType": "submit"
              }
            }
          ]
        }
      ]
    }
  ]
}
