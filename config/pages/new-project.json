{
  "dataSources": {},
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "New Project",
        "subtitle": "Create a new project with budget and timeline"
      }
    },
    {
      "type": "Card",
      "props": {},
      "children": [
        {
          "type": "Form",
          "props": {
            "action": {
              "type": "submit_form",
              "url": "/api/projects",
              "method": "POST",
              "successMessage": "Project created successfully!",
              "redirectTo": "/projects/{{response.data.id}}"
            }
          },
          "children": [
            {
              "type": "Grid",
              "props": {
                "columns": 2,
                "gap": "lg"
              },
              "children": [
                {
                  "type": "TextField",
                  "props": {
                    "name": "name",
                    "label": "Project Name",
                    "required": true,
                    "placeholder": "Enter project name",
                    "colSpan": 2
                  }
                },
                {
                  "type": "TextField",
                  "props": {
                    "name": "clientName",
                    "label": "Client Name",
                    "placeholder": "Enter client or customer name",
                    "colSpan": 2
                  }
                },
                {
                  "type": "TextArea",
                  "props": {
                    "name": "description",
                    "label": "Description",
                    "placeholder": "Describe the project scope and objectives",
                    "rows": 4,
                    "colSpan": 2
                  }
                },
                {
                  "type": "SelectField",
                  "props": {
                    "name": "priority",
                    "label": "Priority",
                    "required": true,
                    "options": [
                      { "label": "Low", "value": "low" },
                      { "label": "Medium", "value": "medium" },
                      { "label": "High", "value": "high" },
                      { "label": "Urgent", "value": "urgent" }
                    ]
                  }
                },
                {
                  "type": "DateField",
                  "props": {
                    "name": "deadline",
                    "label": "Deadline",
                    "required": false
                  }
                },
                {
                  "type": "TextField",
                  "props": {
                    "name": "budgetHours",
                    "label": "Budget Hours",
                    "required": true,
                    "inputType": "number",
                    "placeholder": "100"
                  }
                },
                {
                  "type": "TextField",
                  "props": {
                    "name": "hourlyRate",
                    "label": "Hourly Rate ($)",
                    "required": true,
                    "inputType": "number",
                    "placeholder": "150"
                  }
                },
                {
                  "type": "Stack",
                  "props": {
                    "direction": "horizontal",
                    "justify": "flex-end",
                    "gap": "md"
                  },
                  "children": [
                    {
                      "type": "Button",
                      "props": {
                        "label": "Cancel",
                        "variant": "ghost",
                        "action": {
                          "type": "navigate",
                          "to": "/projects"
                        }
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "label": "Create Project",
                        "variant": "primary",
                        "buttonType": "submit",
                        "icon": "Check"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
