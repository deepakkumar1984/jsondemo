{
  "dataSources": {
    "employees": { "url": "/api/employees" },
    "departments": { "url": "/api/departments" }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Employees",
        "actions": [
          {
            "label": "Add Employee",
            "variant": "primary",
            "icon": "plus",
            "action": {
              "type": "navigate",
              "to": "/employees/new"
            }
          }
        ]
      }
    },
    {
      "type": "DataTable",
      "props": {
        "dataPath": "employees",
        "searchable": true,
        "searchPlaceholder": "Search employees...",
        "paginated": true,
        "pageSize": 20,
        "rowClickAction": {
          "type": "navigate",
          "to": "/employees/:id"
        },
        "columns": [
          {
            "key": "employeeCode",
            "header": "Employee Code",
            "sortable": true
          },
          {
            "key": "fullName",
            "header": "Name",
            "template": "{{firstName}} {{lastName}}",
            "sortable": true
          },
          {
            "key": "email",
            "header": "Email",
            "sortable": true
          },
          {
            "key": "departmentName",
            "header": "Department",
            "sortable": true
          },
          {
            "key": "positionTitle",
            "header": "Position",
            "sortable": true
          },
          {
            "key": "status",
            "header": "Status",
            "sortable": true,
            "render": {
              "type": "Badge",
              "props": {
                "valuePath": "status",
                "colorMap": {
                  "active": "green",
                  "on_leave": "orange",
                  "terminated": "red",
                  "resigned": "gray"
                }
              }
            }
          },
          {
            "key": "dateOfJoining",
            "header": "Join Date",
            "format": "date",
            "sortable": true
          }
        ],
        "filters": [
          {
            "key": "departmentId",
            "label": "Department",
            "type": "select",
            "optionsPath": "departments",
            "optionLabel": "name",
            "optionValue": "id"
          },
          {
            "key": "status",
            "label": "Status",
            "type": "select",
            "options": [
              { "label": "Active", "value": "active" },
              { "label": "On Leave", "value": "on_leave" },
              { "label": "Terminated", "value": "terminated" },
              { "label": "Resigned", "value": "resigned" }
            ]
          },
          {
            "key": "employmentType",
            "label": "Employment Type",
            "type": "select",
            "options": [
              { "label": "Full Time", "value": "full_time" },
              { "label": "Part Time", "value": "part_time" },
              { "label": "Contract", "value": "contract" },
              { "label": "Intern", "value": "intern" }
            ]
          }
        ]
      }
    }
  ]
}
