{
  "page": "todo/create",
  "dataSources": {},
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Create Todo"
      }
    },
    {
      "type": "Form",
      "props": {
        "action": {
          "type": "submit_form",
          "url": "/api/todos",
          "method": "POST",
          "redirectTo": "/todo"
        }
      },
      "children": [
        {
          "type": "TextField",
          "props": {
            "name": "title",
            "label": "Title",
            "required": true
          }
        },
        {
          "type": "TextArea",
          "props": {
            "name": "description",
            "label": "Description"
          }
        },
        {
          "type": "TextField",
          "props": {
            "name": "dueDate",
            "label": "Due Date",
            "type": "date"
          }
        },
        {
          "type": "SelectField",
          "props": {
            "name": "status",
            "label": "Status",
            "options": [
              {
                "label": "Pending",
                "value": "pending"
              },
              {
                "label": "Completed",
                "value": "completed"
              }
            ]
          }
        }
      ]
    }
  ]
}