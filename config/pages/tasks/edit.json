{
  "page": "tasks/edit",
  "dataSources": {
    "item": "/api/tasks/{{id}}"
  },
  "children": [
    {
      "component": "PageHeader",
      "props": {
        "title": "Edit Task"
      }
    },
    {
      "component": "Form",
      "props": {
        "dataSource": "item",
        "fields": [
          {
            "name": "title",
            "label": "Title",
            "type": "text",
            "required": true
          },
          {
            "name": "description",
            "label": "Description",
            "type": "textarea"
          },
          {
            "name": "status",
            "label": "Status",
            "type": "select",
            "options": [
              "Todo",
              "In Progress",
              "Done"
            ],
            "required": true
          },
          {
            "name": "priority",
            "label": "Priority",
            "type": "select",
            "options": [
              "Low",
              "Medium",
              "High"
            ]
          },
          {
            "name": "dueDate",
            "label": "Due Date",
            "type": "date"
          }
        ],
        "submit": {
          "method": "PUT",
          "url": "/api/tasks/{{id}}",
          "redirect": "/tasks/{{id}}"
        }
      }
    }
  ]
}