{
  "page": "tasks/list",
  "dataSources": {
    "items": { "url": "/api/tasks" }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Tasks",
        "actions": [
          {
            "label": "Add New",
            "action": {
              "type": "navigate",
              "to": "/tasks/create"
            }
          },
          {
            "label": "Kanban Board",
            "action": {
              "type": "navigate",
              "to": "/tasks/kanban"
            }
          }
        ]
      }
    },
    {
      "type": "DataTable",
      "props": {
        "dataPath": "items",
        "columns": [
          {
            "key": "title",
            "header": "Title"
          },
          {
            "key": "status",
            "header": "Status",
            "render": { "type": "Badge", "props": { "colorMap": { "todo": "secondary", "in_progress": "default", "done": "outline" } } }
          },
          {
            "key": "priority",
            "header": "Priority"
          },
          {
            "key": "dueDate",
            "header": "Due Date",
            "format": "date"
          }
        ],
        "actions": [
          {
            "label": "View",
            "action": {
              "type": "navigate",
              "to": "/tasks/:id"
            }
          },
          {
            "label": "Edit",
            "action": {
              "type": "navigate",
              "to": "/tasks/:id/edit"
            }
          }
        ]
      }
    }
  ]
}
