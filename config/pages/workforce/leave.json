{
  "dataSources": {
    "leaveRequests": { "url": "/api/workforce/leave-requests" }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Leave Management",
        "subtitle": "Manage employee leave requests and balances"
      }
    },
    {
      "type": "Alert",
      "props": {
        "variant": "info",
        "title": "Under Development",
        "message": "Leave management module is under development. Some features may not be available yet."
      }
    },
    {
      "type": "DataTable",
      "props": {
        "dataPath": "leaveRequests",
        "searchable": true,
        "searchPlaceholder": "Search leave requests...",
        "paginated": true,
        "pageSize": 20,
        "emptyMessage": "No leave requests found.",
        "columns": [
          {
            "key": "employeeName",
            "header": "Employee",
            "sortable": true
          },
          {
            "key": "leaveType",
            "header": "Leave Type",
            "sortable": true,
            "render": {
              "type": "Badge",
              "props": {
                "valuePath": "leaveType",
                "colorMap": {
                  "Annual": "blue",
                  "Sick": "orange",
                  "Casual": "purple",
                  "Maternity": "pink",
                  "Paternity": "teal",
                  "Unpaid": "gray"
                }
              }
            }
          },
          {
            "key": "fromDate",
            "header": "From",
            "format": "date",
            "sortable": true
          },
          {
            "key": "toDate",
            "header": "To",
            "format": "date",
            "sortable": true
          },
          {
            "key": "days",
            "header": "Days",
            "sortable": true
          },
          {
            "key": "status",
            "header": "Status",
            "sortable": true,
            "render": {
              "type": "Badge",
              "props": {
                "valuePath": "status",
                "colorMap": {
                  "approved": "green",
                  "pending": "orange",
                  "rejected": "red"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
