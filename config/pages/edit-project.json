{
  "dataSources": {
    "project": {
      "url": "/api/projects/:id"
    }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Edit Project",
        "subtitle": "Update project details and budget"
      }
    },
    {
      "type": "Card",
      "props": {},
      "children": [
        {
          "type": "Form",
          "props": {
            "action": {
              "type": "submit_form",
              "url": "/api/projects/:id",
              "method": "PUT",
              "successMessage": "Project updated successfully!",
              "redirectTo": "/projects/:id"
            },
            "actions": {
              "buttons": [
                {
                  "label": "Cancel",
                  "variant": "ghost",
                  "action": {
                    "type": "navigate",
                    "to": "/projects/:id"
                  }
                },
                {
                  "label": "Update Project",
                  "variant": "primary",
                  "buttonType": "submit",
                  "icon": "Check"
                }
              ],
              "align": "end",
              "gap": "md"
            }
          },
          "children": [
            {
              "type": "Grid",
              "props": {
                "columns": 2,
                "gap": "lg"
              },
              "children": [
                {
                  "type": "TextField",
                  "props": {
                    "name": "name",
                    "label": "Project Name",
                    "required": true,
                    "placeholder": "Enter project name",
                    "colSpan": 2
                  }
                },
                {
                  "type": "TextField",
                  "props": {
                    "name": "clientName",
                    "label": "Client Name",
                    "placeholder": "Enter client or customer name",
                    "colSpan": 2
                  }
                },
                {
                  "type": "TextArea",
                  "props": {
                    "name": "description",
                    "label": "Description",
                    "placeholder": "Describe the project scope and objectives",
                    "rows": 4,
                    "colSpan": 2
                  }
                },
                {
                  "type": "SelectField",
                  "props": {
                    "name": "priority",
                    "label": "Priority",
                    "required": true,
                    "options": [
                      { "label": "Low", "value": "low" },
                      { "label": "Medium", "value": "medium" },
                      { "label": "High", "value": "high" },
                      { "label": "Urgent", "value": "urgent" }
                    ]
                  }
                },
                {
                  "type": "SelectField",
                  "props": {
                    "name": "status",
                    "label": "Status",
                    "required": false,
                    "options": [
                      { "label": "Planning", "value": "planning" },
                      { "label": "In Progress", "value": "in-progress" },
                      { "label": "Completed", "value": "completed" },
                      { "label": "On Hold", "value": "on-hold" },
                      { "label": "Cancelled", "value": "cancelled" }
                    ]
                  }
                },
                {
                  "type": "DateField",
                  "props": {
                    "name": "deadline",
                    "label": "Deadline",
                    "required": false
                  }
                },
                {
                  "type": "TextField",
                  "props": {
                    "name": "budgetHours",
                    "label": "Budget Hours",
                    "required": true,
                    "inputType": "number",
                    "placeholder": "100"
                  }
                },
                {
                  "type": "TextField",
                  "props": {
                    "name": "hourlyRate",
                    "label": "Hourly Rate ($)",
                    "required": true,
                    "inputType": "number",
                    "placeholder": "150"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
