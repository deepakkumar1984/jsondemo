{
  "dataSources": {
    "projects": {
      "url": "/api/projects"
    }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Projects",
        "subtitle": "Manage all your projects",
        "actions": [
          {
            "label": "New Project",
            "variant": "primary",
            "icon": "Plus",
            "action": {
              "type": "navigate",
              "to": "/projects/new"
            }
          }
        ]
      }
    },
    {
      "type": "Card",
      "props": {},
      "children": [
        {
          "type": "DataTable",
          "props": {
            "dataPath": "projects",
            "searchable": true,
            "searchPlaceholder": "Search projects, clients...",
            "paginated": true,
            "pageSize": 20,
            "filters": [
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "options": [
                  { "label": "All Statuses", "value": "__all__" },
                  { "label": "Planning", "value": "planning" },
                  { "label": "Active", "value": "active" },
                  { "label": "On Hold", "value": "on-hold" },
                  { "label": "Completed", "value": "completed" },
                  { "label": "Cancelled", "value": "cancelled" }
                ]
              },
              {
                "key": "priority",
                "label": "Priority",
                "type": "select",
                "options": [
                  { "label": "All Priorities", "value": "__all__" },
                  { "label": "Low", "value": "low" },
                  { "label": "Medium", "value": "medium" },
                  { "label": "High", "value": "high" },
                  { "label": "Urgent", "value": "urgent" }
                ]
              }
            ],
            "columns": [
              {
                "key": "name",
                "header": "Project Name",
                "sortable": true
              },
              {
                "key": "clientName",
                "header": "Client",
                "sortable": true
              },
              {
                "key": "status",
                "header": "Status",
                "sortable": true,
                "render": {
                  "type": "Badge",
                  "props": {
                    "labelPath": "status",
                    "colorMap": {
                      "planning": "secondary",
                      "in-progress": "default",
                      "in_progress": "default",
                      "completed": "default",
                      "on-hold": "outline",
                      "on_hold": "outline",
                      "cancelled": "destructive"
                    }
                  }
                }
              },
              {
                "key": "priority",
                "header": "Priority",
                "sortable": true,
                "render": {
                  "type": "Badge",
                  "props": {
                    "labelPath": "priority",
                    "colorMap": {
                      "low": "outline",
                      "medium": "secondary",
                      "high": "default",
                      "urgent": "destructive"
                    }
                  }
                }
              },
              {
                "key": "budgetHours",
                "header": "Budget (hrs)",
                "sortable": true,
                "format": "number"
              },
              {
                "key": "hourlyRate",
                "header": "Rate",
                "sortable": true,
                "template": "${{hourlyRate}}/hr"
              },
              {
                "key": "deadline",
                "header": "Deadline",
                "sortable": true,
                "format": "date"
              },
              {
                "key": "createdAt",
                "header": "Created",
                "sortable": true,
                "format": "date"
              }
            ],
            "rowClickAction": {
              "type": "navigate",
              "to": "/projects/{{id}}"
            },
            "emptyMessage": "No projects found. Create your first project!"
          }
        }
      ]
    }
  ]
}
