{
  "dataSources": {
    "project": {
      "url": "/api/projects/:id"
    },
    "timeEntries": {
      "url": "/api/projects/:id/time-entries"
    }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "titleParts": [
          { "text": "Project: " },
          { "textPath": "project.name" }
        ],
        "actions": [
          {
            "label": "Add Time",
            "variant": "primary",
            "icon": "Clock",
            "action": {
              "type": "navigate",
              "to": "/projects/:id/time-entries/new"
            }
          },
          {
            "label": "Edit",
            "variant": "secondary",
            "icon": "Edit",
            "action": {
              "type": "navigate",
              "to": "/projects/:id/edit"
            }
          },
          {
            "label": "Delete",
            "variant": "ghost-danger",
            "icon": "Trash",
            "action": {
              "type": "delete_confirm",
              "url": "/api/projects/:id",
              "message": "Are you sure you want to delete this project? This action cannot be undone.",
              "redirectTo": "/projects"
            }
          }
        ]
      }
    },
    {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "lg"
      },
      "children": [
        {
          "type": "StatCard",
          "props": {
            "label": "Total Hours",
            "valuePath": "project.totalHours",
            "icon": "Clock",
            "color": "blue"
          }
        },
        {
          "type": "StatCard",
          "props": {
            "label": "Total Cost",
            "valuePath": "project.totalCost",
            "icon": "DollarSign",
            "color": "green"
          }
        },
        {
          "type": "StatCard",
          "props": {
            "label": "Budget Used",
            "valuePath": "project.budgetUsedPercentage",
            "icon": "PieChart",
            "color": "orange"
          }
        },
        {
          "type": "StatCard",
          "props": {
            "label": "Remaining Hours",
            "valuePath": "project.remainingHours",
            "icon": "Hourglass",
            "color": "purple"
          }
        }
      ]
    },
    {
      "type": "Alert",
      "props": {
        "variant": "warning",
        "title": "Budget Warning",
        "message": "This project has exceeded its allocated budget."
      }
    },
    {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "lg"
      },
      "children": [
        {
          "type": "Card",
          "props": {},
          "children": [
            {
              "type": "Stack",
              "props": {
                "direction": "vertical",
                "gap": "md"
              },
              "children": [
                {
                  "type": "DetailSection",
                  "props": {
                    "title": "Project Details"
                  },
                  "children": [
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Client",
                        "valuePath": "project.clientName"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Status",
                        "valuePath": "project.status",
                        "render": {
                          "type": "Badge",
                          "props": {
                            "colorMap": {
                              "planning": "secondary",
                              "in-progress": "default",
                              "in_progress": "default",
                              "completed": "default",
                              "on-hold": "outline",
                              "on_hold": "outline",
                              "cancelled": "destructive"
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Priority",
                        "valuePath": "project.priority",
                        "render": {
                          "type": "Badge",
                          "props": {
                            "colorMap": {
                              "low": "outline",
                              "medium": "secondary",
                              "high": "default",
                              "urgent": "destructive"
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Description",
                        "valuePath": "project.description"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Card",
          "props": {},
          "children": [
            {
              "type": "Stack",
              "props": {
                "direction": "vertical",
                "gap": "md"
              },
              "children": [
                {
                  "type": "DetailSection",
                  "props": {
                    "title": "Budget & Timeline"
                  },
                  "children": [
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Budget Hours",
                        "valuePath": "project.budgetHours"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Hourly Rate",
                        "valuePath": "project.hourlyRate"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Total Budget",
                        "valuePath": "project.totalBudget"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Deadline",
                        "valuePath": "project.deadline",
                        "format": "date"
                      }
                    },
                    {
                      "type": "DetailRow",
                      "props": {
                        "label": "Started At",
                        "valuePath": "project.startedAt",
                        "format": "datetime"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Card",
      "props": {},
      "children": [
        {
          "type": "Stack",
          "props": {
            "direction": "vertical",
            "gap": "md"
          },
          "children": [
            {
              "type": "PageHeader",
              "props": {
                "title": "Time Entries",
                "subtitle": "{{timeEntries.statistics.totalEntries}} entries, {{timeEntries.statistics.totalHours}} hours total",
                "actions": [
                  {
                    "label": "Add Time",
                    "variant": "primary",
                    "icon": "Plus",
                    "action": {
                      "type": "navigate",
                      "to": "/projects/:id/time-entries/new"
                    }
                  }
                ]
              }
            },
            {
              "type": "DataTable",
              "props": {
                "dataPath": "timeEntries.entries",
                "searchable": true,
                "searchPlaceholder": "Search time entries...",
                "paginated": true,
                "pageSize": 10,
                "columns": [
                  {
                    "key": "date",
                    "header": "Date",
                    "sortable": true,
                    "format": "date"
                  },
                  {
                    "key": "hours",
                    "header": "Hours",
                    "sortable": true,
                    "format": "number"
                  },
                  {
                    "key": "description",
                    "header": "Description",
                    "sortable": false
                  },
                  {
                    "key": "cost",
                    "header": "Cost",
                    "sortable": true,
                    "format": "currency"
                  },
                  {
                    "key": "billable",
                    "header": "Billable",
                    "sortable": true,
                    "render": {
                      "type": "Badge",
                      "props": {
                        "labelPath": "billable",
                        "colorMap": {
                          "true": "default",
                          "false": "outline"
                        }
                      }
                    }
                  },
                  {
                    "key": "createdAt",
                    "header": "Logged",
                    "sortable": true,
                    "format": "datetime"
                  }
                ],
                "emptyMessage": "No time entries yet. Click 'Add Time' to log your first entry!"
              }
            }
          ]
        }
      ]
    }
  ]
}
