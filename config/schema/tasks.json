{
  "table": "tasks",
  "description": "Task records for project management, including assignments, statuses, and timelines",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "defaultFn": "uuid",
      "description": "Unique task identifier"
    },
    {
      "name": "project_id",
      "type": "uuid",
      "notNull": true,
      "references": {
        "table": "projects",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "Reference to the project this task belongs to"
    },
    {
      "name": "title",
      "type": "text",
      "notNull": true,
      "description": "Task title"
    },
    {
      "name": "description",
      "type": "text",
      "notNull": false,
      "description": "Optional task description"
    },
    {
      "name": "status",
      "type": "text",
      "notNull": true,
      "enum": [
        "Backlog",
        "Todo",
        "InProgress",
        "Blocked",
        "Done"
      ],
      "description": "Task status"
    },
    {
      "name": "priority",
      "type": "text",
      "notNull": true,
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "description": "Task priority"
    },
    {
      "name": "assignee_user_id",
      "type": "uuid",
      "notNull": false,
      "references": {
        "table": "users",
        "column": "id",
        "onDelete": "set null"
      },
      "description": "Reference to the assigned user"
    },
    {
      "name": "reporter_user_id",
      "type": "uuid",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "Reference to the user who reported the task"
    },
    {
      "name": "due_date",
      "type": "timestamptz",
      "notNull": false,
      "description": "Optional due date for the task"
    },
    {
      "name": "start_date",
      "type": "timestamptz",
      "notNull": false,
      "description": "Optional start date for the task"
    },
    {
      "name": "completed_at",
      "type": "timestamptz",
      "notNull": false,
      "description": "Timestamp when the task was completed"
    },
    {
      "name": "estimate_points",
      "type": "integer",
      "notNull": false,
      "description": "Optional estimate points for the task"
    },
    {
      "name": "tags",
      "type": "jsonb",
      "notNull": false,
      "description": "Optional array of tags as JSON"
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the task was created"
    },
    {
      "name": "updated_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the task was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_tasks_project_id",
      "columns": [
        "project_id"
      ]
    },
    {
      "name": "idx_tasks_status",
      "columns": [
        "status"
      ]
    },
    {
      "name": "idx_tasks_assignee_user_id",
      "columns": [
        "assignee_user_id"
      ]
    },
    {
      "name": "idx_tasks_priority",
      "columns": [
        "priority"
      ]
    },
    {
      "name": "idx_tasks_due_date",
      "columns": [
        "due_date"
      ]
    },
    {
      "name": "idx_tasks_updated_at",
      "columns": [
        "updated_at"
      ]
    }
  ]
}