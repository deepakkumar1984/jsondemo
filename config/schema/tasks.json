{
  "table": "tasks",
  "description": "Individual tasks within projects",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid"
    },
    {
      "name": "title",
      "type": "text",
      "notNull": true
    },
    {
      "name": "description",
      "type": "text"
    },
    {
      "name": "status",
      "type": "text",
      "enum": [
        "todo",
        "in_progress",
        "done"
      ],
      "default": "todo"
    },
    {
      "name": "priority",
      "type": "integer",
      "default": 0
    },
    {
      "name": "dueDate",
      "type": "text"
    },
    {
      "name": "projectId",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "projects",
        "column": "id"
      }
    },
    {
      "name": "assigneeId",
      "type": "text",
      "references": {
        "table": "users",
        "column": "id"
      }
    },
    {
      "name": "createdById",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id"
      }
    },
    {
      "name": "createdAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    },
    {
      "name": "updatedAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    }
  ]
}