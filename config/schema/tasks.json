{
  "table": "tasks",
  "description": "Task records within projects, including status, priority, assignments, timelines, estimates, and tags",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid",
      "description": "Unique task identifier"
    },
    {
      "name": "project_id",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "projects",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "Reference to the parent project"
    },
    {
      "name": "title",
      "type": "text",
      "notNull": true,
      "description": "Task title (required, length validated in application)"
    },
    {
      "name": "description",
      "type": "text",
      "notNull": false,
      "description": "Optional task description (rich text/string)"
    },
    {
      "name": "status",
      "type": "text",
      "notNull": true,
      "default": "Todo",
      "description": "Task status (Backlog, Todo, InProgress, Blocked, Done)"
    },
    {
      "name": "priority",
      "type": "text",
      "notNull": true,
      "default": "Medium",
      "description": "Task priority (Low, Medium, High, Urgent)"
    },
    {
      "name": "assignee_user_id",
      "type": "text",
      "notNull": false,
      "references": {
        "table": "users",
        "column": "id",
        "onDelete": "set null"
      },
      "description": "Optional user assigned to the task"
    },
    {
      "name": "reporter_user_id",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id",
        "onDelete": "set null"
      },
      "description": "User who reported/created the task"
    },
    {
      "name": "due_date",
      "type": "timestamp",
      "notNull": false,
      "description": "Task due date-time (must be >= start_date when both present, validated in application)"
    },
    {
      "name": "start_date",
      "type": "timestamp",
      "notNull": false,
      "description": "Task start date-time"
    },
    {
      "name": "completed_at",
      "type": "timestamp",
      "notNull": false,
      "description": "Task completion date-time (required when status=Done, cleared otherwise, validated in application)"
    },
    {
      "name": "estimate_points",
      "type": "numeric",
      "notNull": false,
      "description": "Estimated effort points (minimum 0, validated in application)"
    },
    {
      "name": "tags",
      "type": "jsonb",
      "notNull": false,
      "description": "Optional array of task tags as strings"
    },
    {
      "name": "created_at",
      "type": "timestamp",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when task was created"
    },
    {
      "name": "updated_at",
      "type": "timestamp",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when task was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_tasks_project_id",
      "columns": [
        "project_id"
      ]
    },
    {
      "name": "idx_tasks_status",
      "columns": [
        "status"
      ]
    },
    {
      "name": "idx_tasks_assignee_user_id",
      "columns": [
        "assignee_user_id"
      ]
    },
    {
      "name": "idx_tasks_priority",
      "columns": [
        "priority"
      ]
    },
    {
      "name": "idx_tasks_due_date",
      "columns": [
        "due_date"
      ]
    },
    {
      "name": "idx_tasks_updated_at",
      "columns": [
        "updated_at"
      ]
    }
  ]
}