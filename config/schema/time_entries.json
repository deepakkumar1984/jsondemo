{
  "table": "time_entries",
  "description": "Time tracking entries for projects",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid",
      "description": "Unique time entry identifier"
    },
    {
      "name": "projectId",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "projects",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "Associated project"
    },
    {
      "name": "userId",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "User who logged the time"
    },
    {
      "name": "hours",
      "type": "numeric",
      "notNull": true,
      "description": "Number of hours worked"
    },
    {
      "name": "description",
      "type": "text",
      "notNull": true,
      "description": "What was worked on"
    },
    {
      "name": "date",
      "type": "text",
      "notNull": true,
      "description": "Date the work was performed"
    },
    {
      "name": "hourlyRate",
      "type": "numeric",
      "notNull": true,
      "description": "Hourly rate at time of entry"
    },
    {
      "name": "cost",
      "type": "numeric",
      "notNull": true,
      "description": "Total cost (hours × hourlyRate)"
    },
    {
      "name": "billable",
      "type": "boolean",
      "default": true,
      "description": "Whether this time is billable"
    },
    {
      "name": "createdAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP",
      "notNull": true
    },
    {
      "name": "updatedAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP",
      "notNull": true
    }
  ],
  "indexes": [
    {
      "name": "idx_time_entries_project",
      "columns": ["projectId"]
    },
    {
      "name": "idx_time_entries_user",
      "columns": ["userId"]
    },
    {
      "name": "idx_time_entries_date",
      "columns": ["date"]
    }
  ]
}
