{
  "table": "task_comments",
  "description": "Comments on tasks for collaboration and discussion",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid",
      "description": "Unique comment identifier"
    },
    {
      "name": "task_id",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "tasks",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "Reference to the parent task"
    },
    {
      "name": "author_user_id",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "Reference to the comment author"
    },
    {
      "name": "body",
      "type": "text",
      "notNull": true,
      "description": "Comment content, must be non-empty with max length validation"
    },
    {
      "name": "created_at",
      "type": "timestamp",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "When the comment was created"
    },
    {
      "name": "updated_at",
      "type": "timestamp",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "When the comment was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_task_comments_task_id",
      "columns": [
        "task_id"
      ],
      "description": "Index for retrieving comments by task"
    },
    {
      "name": "idx_task_comments_created_at",
      "columns": [
        "created_at"
      ],
      "description": "Index for chronological ordering"
    },
    {
      "name": "idx_task_comments_task_created",
      "columns": [
        "task_id",
        "created_at"
      ],
      "description": "Composite index for ordered retrieval on task detail views"
    }
  ]
}