{
  "table": "projects",
  "description": "Projects grouping tasks",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true
    },
    {
      "name": "description",
      "type": "text"
    },
    {
      "name": "ownerId",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id"
      }
    },
    {
      "name": "startDate",
      "type": "text"
    },
    {
      "name": "endDate",
      "type": "text"
    },
    {
      "name": "createdAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    },
    {
      "name": "updatedAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    }
  ]
}