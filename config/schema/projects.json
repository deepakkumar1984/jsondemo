{
  "table": "projects",
  "description": "Project records with status tracking and ownership",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid",
      "description": "Unique project identifier"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true,
      "description": "Project name, must be unique within workspace"
    },
    {
      "name": "description",
      "type": "text",
      "notNull": false,
      "description": "Optional project description"
    },
    {
      "name": "status",
      "type": "text",
      "notNull": true,
      "default": "Active",
      "description": "Project status: Active or Archived"
    },
    {
      "name": "owner_user_id",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "Reference to the project owner"
    },
    {
      "name": "created_at",
      "type": "timestamp",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "When the project was created"
    },
    {
      "name": "updated_at",
      "type": "timestamp",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "When the project was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_projects_status",
      "columns": [
        "status"
      ]
    },
    {
      "name": "idx_projects_owner",
      "columns": [
        "owner_user_id"
      ]
    },
    {
      "name": "idx_projects_updated_at",
      "columns": [
        "updated_at"
      ]
    },
    {
      "name": "idx_projects_owner_status",
      "columns": [
        "owner_user_id",
        "status"
      ]
    }
  ]
}