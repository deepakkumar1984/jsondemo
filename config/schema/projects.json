{
  "table": "projects",
  "description": "Project records with ownership and status tracking",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "defaultFn": "uuid",
      "description": "Unique project identifier"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true,
      "unique": true,
      "description": "Project name, unique globally"
    },
    {
      "name": "description",
      "type": "text",
      "notNull": false,
      "description": "Optional project description"
    },
    {
      "name": "status",
      "type": "text",
      "notNull": true,
      "enum": [
        "Active",
        "Archived"
      ],
      "description": "Project status"
    },
    {
      "name": "owner_user_id",
      "type": "uuid",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "Reference to the user who owns the project"
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the project was created"
    },
    {
      "name": "updated_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the project was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_projects_status",
      "columns": [
        "status"
      ]
    },
    {
      "name": "idx_projects_owner_user_id",
      "columns": [
        "owner_user_id"
      ]
    },
    {
      "name": "idx_projects_updated_at",
      "columns": [
        "updated_at"
      ]
    }
  ]
}