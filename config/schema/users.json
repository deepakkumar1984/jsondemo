{
  "table": "users",
  "description": "User accounts with authentication",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "defaultFn": "uuid",
      "notNull": true,
      "description": "Unique user identifier"
    },
    {
      "name": "email",
      "type": "text",
      "unique": true,
      "notNull": true,
      "description": "User's email address"
    },
    {
      "name": "username",
      "type": "text",
      "unique": true,
      "description": "Unique username for the user"
    },
    {
      "name": "display_name",
      "type": "text",
      "notNull": true,
      "default": "",
      "description": "Display name for the user"
    },
    {
      "name": "avatar_url",
      "type": "text",
      "description": "URL to user's avatar image"
    },
    {
      "name": "bio",
      "type": "text",
      "description": "User biography or description"
    },
    {
      "name": "provider",
      "type": "text",
      "notNull": true,
      "default": "local",
      "description": "Authentication provider (e.g., 'local', 'google', 'github')"
    },
    {
      "name": "provider_id",
      "type": "text",
      "notNull": true,
      "default": "",
      "description": "ID from the authentication provider"
    },
    {
      "name": "email_verified",
      "type": "boolean",
      "default": false,
      "description": "Whether the email has been verified"
    },
    {
      "name": "password_hash",
      "type": "text",
      "description": "Hashed password for local authentication"
    },
    {
      "name": "failed_login_attempts",
      "type": "integer",
      "default": 0,
      "description": "Count of failed login attempts"
    },
    {
      "name": "locked_until",
      "type": "timestamp",
      "description": "Account lock expiration timestamp"
    },
    {
      "name": "password_changed_at",
      "type": "timestamp",
      "description": "When password was last changed"
    },
    {
      "name": "preferences",
      "type": "jsonb",
      "default": "{}",
      "description": "User preferences as JSON"
    },
    {
      "name": "theme",
      "type": "text",
      "default": "system",
      "enum": ["light", "dark", "system"],
      "description": "User's preferred theme"
    },
    {
      "name": "timezone",
      "type": "text",
      "default": "UTC",
      "description": "User's timezone"
    },
    {
      "name": "role",
      "type": "text",
      "enum": ["admin", "user", "moderator"],
      "notNull": true,
      "description": "User role for access control"
    },
    {
      "name": "is_active",
      "type": "boolean",
      "default": true,
      "description": "Whether the account is active"
    },
    {
      "name": "is_suspended",
      "type": "boolean",
      "default": false,
      "description": "Whether the account is suspended"
    },
    {
      "name": "created_at",
      "type": "timestamp",
      "default": "CURRENT_TIMESTAMP",
      "notNull": true,
      "description": "When the user was created"
    },
    {
      "name": "updated_at",
      "type": "timestamp",
      "default": "CURRENT_TIMESTAMP",
      "notNull": true,
      "description": "When the user was last updated"
    },
    {
      "name": "last_active_at",
      "type": "timestamp",
      "description": "When the user was last active"
    },
    {
      "name": "deleted_at",
      "type": "timestamp",
      "description": "Soft delete timestamp"
    }
  ],
  "indexes": [
    {
      "name": "users_email_idx",
      "columns": ["email"]
    },
    {
      "name": "users_username_idx",
      "columns": ["username"]
    },
    {
      "name": "users_provider_provider_id_idx",
      "columns": ["provider", "provider_id"]
    }
  ]
}