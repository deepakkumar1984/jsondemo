{
  "table": "vendors",
  "description": "Vendor records for expenses",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "defaultFn": "uuid",
      "description": "Unique vendor identifier"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true,
      "description": "Name of the vendor"
    },
    {
      "name": "website",
      "type": "text",
      "notNull": false,
      "description": "Vendor website URL"
    },
    {
      "name": "notes",
      "type": "text",
      "notNull": false,
      "description": "Additional notes about the vendor"
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the vendor was created"
    },
    {
      "name": "updated_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the vendor was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_vendors_name",
      "columns": [
        "name"
      ],
      "unique": true
    }
  ]
}