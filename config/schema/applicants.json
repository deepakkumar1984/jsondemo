{
  "table": "applicants",
  "description": "Job applicants",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid"
    },
    {
      "name": "jobId",
      "type": "text",
      "references": {
        "table": "job_postings",
        "column": "id"
      },
      "notNull": true
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true
    },
    {
      "name": "email",
      "type": "text",
      "notNull": true
    },
    {
      "name": "phone",
      "type": "text"
    },
    {
      "name": "resumeUrl",
      "type": "text"
    },
    {
      "name": "status",
      "type": "text",
      "enum": [
        "applied",
        "screening",
        "interview",
        "offered",
        "rejected",
        "hired"
      ],
      "default": "applied"
    },
    {
      "name": "appliedDate",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    }
  ]
}