{
  "table": "task_activities",
  "description": "Audit log for task activities including changes and events",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "defaultFn": "uuid",
      "description": "Unique activity identifier"
    },
    {
      "name": "task_id",
      "type": "uuid",
      "notNull": true,
      "references": {
        "table": "tasks",
        "column": "id",
        "onDelete": "cascade"
      },
      "description": "Reference to the task this activity belongs to"
    },
    {
      "name": "actor_user_id",
      "type": "uuid",
      "notNull": false,
      "references": {
        "table": "users",
        "column": "id",
        "onDelete": "set null"
      },
      "description": "Reference to the user who performed the activity, optional for automated events"
    },
    {
      "name": "event_type",
      "type": "text",
      "notNull": true,
      "enum": [
        "Created",
        "Updated",
        "StatusChanged",
        "Assigned",
        "Unassigned",
        "Commented",
        "DueDateChanged",
        "PriorityChanged",
        "Tagged"
      ],
      "description": "Type of activity event"
    },
    {
      "name": "from_value",
      "type": "jsonb",
      "notNull": false,
      "description": "Previous value for the change, optional"
    },
    {
      "name": "to_value",
      "type": "jsonb",
      "notNull": false,
      "description": "New value for the change, optional"
    },
    {
      "name": "metadata",
      "type": "jsonb",
      "notNull": false,
      "description": "Additional metadata for the activity"
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the activity was created"
    },
    {
      "name": "updated_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the activity was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_task_activities_task_id",
      "columns": [
        "task_id"
      ]
    },
    {
      "name": "idx_task_activities_event_type",
      "columns": [
        "event_type"
      ]
    },
    {
      "name": "idx_task_activities_created_at",
      "columns": [
        "created_at"
      ]
    }
  ]
}