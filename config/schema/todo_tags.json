{
  "table": "todo_tags",
  "description": "Many-to-many relationship between todos and tags",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid"
    },
    {
      "name": "todoId",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "todos",
        "column": "id"
      }
    },
    {
      "name": "tagId",
      "type": "text",
      "notNull": true,
      "references": {
        "table": "tags",
        "column": "id"
      }
    },
    {
      "name": "createdAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    },
    {
      "name": "updatedAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    }
  ]
}