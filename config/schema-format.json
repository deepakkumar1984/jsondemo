{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Database Schema Configuration",
  "description": "JSON schema for defining database tables using Drizzle ORM conventions",
  "type": "object",
  "required": ["table", "columns"],
  "properties": {
    "table": {
      "type": "string",
      "description": "Table name in the database"
    },
    "description": {
      "type": "string",
      "description": "Description of what this table stores"
    },
    "columns": {
      "type": "array",
      "description": "Array of column definitions",
      "items": {
        "$ref": "#/definitions/column"
      }
    },
    "indexes": {
      "type": "array",
      "description": "Array of index definitions",
      "items": {
        "$ref": "#/definitions/index"
      }
    }
  },
  "definitions": {
    "column": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Database column name in snake_case strictly, e.g., 'id', 'username', 'created_at', 'updated_at', 'client_name'. Use primary key id to be uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "text", "varchar", "char",
            "integer", "smallint", "bigint", "serial", "bigserial",
            "real", "double precision", "numeric", "decimal",
            "boolean",
            "timestamp", "timestamptz", "date", "time", "timetz", "interval",
            "uuid",
            "json", "jsonb",
            "bytea", "blob"
          ],
          "description": "PostgreSQL column type"
        },
        "primaryKey": {
          "type": "boolean",
          "description": "Whether this is the primary key"
        },
        "notNull": {
          "type": "boolean",
          "description": "Whether NULL values are forbidden"
        },
        "unique": {
          "type": "boolean",
          "description": "Whether values must be unique"
        },
        "default": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ],
          "description": "Default value (use 'CURRENT_TIMESTAMP' for SQL default)"
        },
        "defaultFn": {
          "type": "string",
          "enum": ["uuid"],
          "description": "Default function to call (e.g., 'uuid' for crypto.randomUUID())"
        },
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed enum values"
        },
        "references": {
          "type": "object",
          "required": ["table", "column"],
          "properties": {
            "table": {
              "type": "string",
              "description": "Referenced table name"
            },
            "column": {
              "type": "string",
              "description": "Referenced column name"
            },
            "onDelete": {
              "type": "string",
              "enum": ["cascade", "set null", "restrict", "no action"],
              "description": "Action on delete"
            }
          },
          "description": "Foreign key reference"
        },
        "description": {
          "type": "string",
          "description": "Column description for documentation"
        }
      }
    },
    "index": {
      "type": "object",
      "required": ["name", "columns"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Index name"
        },
        "columns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Columns included in this index"
        },
        "unique": {
          "type": "boolean",
          "description": "Whether this is a unique index"
        }
      }
    }
  }
}
