{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "API Configuration Format (Operation-Based)",
  "description": "Config-driven API with operation-based architecture supporting typed action blocks",
  "type": "object",
  "required": ["name", "basePath", "operations"],
  "properties": {
    "name": {
      "type": "string",
      "description": "API name (e.g., 'Projects API', 'Orders API')"
    },
    "version": {
      "type": "string",
      "description": "API version (e.g., 'v1', 'v2')"
    },
    "basePath": {
      "type": "string",
      "description": "Base API path (e.g., '/api/projects')",
      "pattern": "^/api/"
    },
    "description": {
      "type": "string"
    },
    "auth": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean", "default": true },
        "type": {
          "type": "string",
          "enum": ["ApiKey", "OAuth", "JWT"]
        },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "requestsPerMinute": { "type": "number" }
      }
    },
    "operations": {
      "type": "array",
      "description": "Array of API operations (endpoints)",
      "items": { "$ref": "#/definitions/operation" }
    }
  },
  "definitions": {
    "operation": {
      "type": "object",
      "required": ["id", "method", "path", "actions"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique operation identifier (e.g., 'createProject', 'listOrders')"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "path": {
          "type": "string",
          "description": "Operation path relative to basePath (e.g., '/', '/:id')"
        },
        "description": {
          "type": "string"
        },
        "requestSchema": {
          "type": "object",
          "description": "JSON Schema for request body validation"
        },
        "responseSchema": {
          "type": "object",
          "description": "JSON Schema for response body"
        },
        "actions": {
          "type": "array",
          "description": "Workflow actions to execute",
          "items": { "$ref": "#/definitions/action" }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "tags": { "type": "array", "items": { "type": "string" } },
            "version": { "type": "string" },
            "deprecated": { "type": "boolean" },
            "sla": { "type": "number" },
            "auditEnabled": { "type": "boolean" }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "validate",
            "transform",
            "transform.array",
            "calc",
            "condition",
            "loop",
            "db.query",
            "db.insert",
            "db.update",
            "db.delete",
            "db.bulkInsert",
            "http.call",
            "cache.get",
            "cache.set",
            "cache.delete",
            "transaction",
            "parallel",
            "response.map",
            "try"
          ]
        }
      },
      "oneOf": [
        { "$ref": "#/definitions/validateAction" },
        { "$ref": "#/definitions/transformAction" },
        { "$ref": "#/definitions/transformArrayAction" },
        { "$ref": "#/definitions/calcAction" },
        { "$ref": "#/definitions/conditionAction" },
        { "$ref": "#/definitions/loopAction" },
        { "$ref": "#/definitions/dbQueryAction" },
        { "$ref": "#/definitions/dbInsertAction" },
        { "$ref": "#/definitions/dbUpdateAction" },
        { "$ref": "#/definitions/dbDeleteAction" },
        { "$ref": "#/definitions/dbBulkInsertAction" },
        { "$ref": "#/definitions/httpCallAction" },
        { "$ref": "#/definitions/cacheGetAction" },
        { "$ref": "#/definitions/cacheSetAction" },
        { "$ref": "#/definitions/cacheDeleteAction" },
        { "$ref": "#/definitions/transactionAction" },
        { "$ref": "#/definitions/parallelAction" },
        { "$ref": "#/definitions/responseMapAction" },
        { "$ref": "#/definitions/tryAction" }
      ]
    },
    "validateAction": {
      "type": "object",
      "required": ["type", "rules"],
      "properties": {
        "type": { "const": "validate" },
        "rules": {
          "type": "array",
          "description": "Validation rules to apply",
          "items": {
            "type": "object",
            "required": ["field", "rule"],
            "properties": {
              "field": {
                "type": "string",
                "description": "Field path to validate (e.g., 'budgetHours', 'body.email', 'query.limit', 'params.id')"
              },
              "rule": {
                "type": "string",
                "enum": ["required", "min", "max", "email", "pattern", "length", "in", "custom"],
                "description": "Validation rule type"
              },
              "value": {
                "description": "Value for the validation rule (e.g., min value, max value, pattern)"
              },
              "message": {
                "type": "string",
                "description": "Custom error message"
              }
            }
          }
        }
      }
    },
    "transformAction": {
      "type": "object",
      "required": ["type", "set"],
      "properties": {
        "type": { "const": "transform" },
        "set": {
          "type": "object",
          "description": "Key-value pairs where key is target path and value is expression or template",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "transformArrayAction": {
      "type": "object",
      "required": ["type", "from", "fieldMap"],
      "properties": {
        "type": { "const": "transform.array" },
        "from": {
          "type": "string",
          "description": "Source array variable name"
        },
        "fieldMap": {
          "type": "object",
          "description": "Map of target field to source field for transformation",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "calcAction": {
      "type": "object",
      "required": ["type", "set"],
      "properties": {
        "type": { "const": "calc" },
        "set": {
          "type": "object",
          "description": "Calculations where key is variable name and value is expression",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "conditionAction": {
      "type": "object",
      "required": ["type", "if", "then"],
      "properties": {
        "type": { "const": "condition" },
        "if": {
          "type": "string",
          "description": "Conditional expression to evaluate (e.g., '{{project == null}}')"
        },
        "then": {
          "type": "array",
          "description": "Actions to execute if condition is true",
          "items": { "$ref": "#/definitions/action" }
        },
        "else": {
          "type": "array",
          "description": "Actions to execute if condition is false",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "loopAction": {
      "type": "object",
      "required": ["type", "over", "actions"],
      "properties": {
        "type": { "const": "loop" },
        "over": {
          "type": "string",
          "description": "Array variable to iterate over"
        },
        "as": {
          "type": "string",
          "description": "Variable name for current item (default: 'item')"
        },
        "actions": {
          "type": "array",
          "description": "Actions to execute for each item",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "dbQueryAction": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "db.query" },
        "table": {
          "type": "string",
          "description": "Database table name (not required if using raw SQL)"
        },
        "sql": {
          "type": "string",
          "description": "Raw SQL query (alternative to table-based query, supports template expressions)"
        },
        "where": {
          "type": "object",
          "description": "WHERE clause conditions (supports template expressions)",
          "additionalProperties": true
        },
        "select": {
          "type": "array",
          "description": "Fields to select",
          "items": { "type": "string" }
        },
        "joins": {
          "type": "array",
          "description": "Join clauses for multi-table queries",
          "items": {
            "type": "object",
            "required": ["type", "table", "on"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["INNER", "LEFT", "RIGHT", "FULL"],
                "description": "Join type"
              },
              "table": {
                "type": "string",
                "description": "Table to join"
              },
              "as": {
                "type": "string",
                "description": "Table alias"
              },
              "on": {
                "type": "object",
                "description": "Join conditions (e.g., {'projects.id': 'time_entries.project_id'})",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        },
        "orderBy": {
          "type": "array",
          "description": "Order by fields",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "direction": { "enum": ["ASC", "DESC"] }
            }
          }
        },
        "limit": {
          "description": "Maximum number of records to return (supports template expressions like '{{query.limit}}')",
          "oneOf": [
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "offset": {
          "description": "Number of records to skip (supports template expressions like '{{query.offset}}')",
          "oneOf": [
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "into": {
          "type": "string",
          "description": "Variable name to store query results"
        }
      },
      "oneOf": [
        { "required": ["table", "into"] },
        { "required": ["sql", "into"] }
      ]
    },
    "dbInsertAction": {
      "type": "object",
      "required": ["type", "table", "map"],
      "properties": {
        "type": { "const": "db.insert" },
        "table": {
          "type": "string",
          "description": "Database table name"
        },
        "map": {
          "type": "object",
          "description": "Field mappings for insert (column: value expression)",
          "additionalProperties": { "type": "string" }
        },
        "returning": {
          "type": "string",
          "description": "Variable name to store the inserted record ID or data"
        }
      }
    },
    "dbUpdateAction": {
      "type": "object",
      "required": ["type", "table", "where", "map"],
      "properties": {
        "type": { "const": "db.update" },
        "table": {
          "type": "string",
          "description": "Database table name"
        },
        "where": {
          "type": "object",
          "description": "WHERE clause conditions",
          "additionalProperties": true
        },
        "map": {
          "type": "object",
          "description": "Field mappings for update (column: value expression)",
          "additionalProperties": { "type": "string" }
        },
        "returning": {
          "type": "string",
          "description": "Variable name to store the updated record data"
        }
      }
    },
    "dbDeleteAction": {
      "type": "object",
      "required": ["type", "table", "where"],
      "properties": {
        "type": { "const": "db.delete" },
        "table": {
          "type": "string",
          "description": "Database table name"
        },
        "where": {
          "type": "object",
          "description": "WHERE clause conditions",
          "additionalProperties": true
        },
        "returning": {
          "type": "string",
          "description": "Variable name to store deletion confirmation"
        }
      }
    },
    "dbBulkInsertAction": {
      "type": "object",
      "required": ["type", "table", "records"],
      "properties": {
        "type": { "const": "db.bulkInsert" },
        "table": {
          "type": "string",
          "description": "Database table name"
        },
        "records": {
          "type": "string",
          "description": "Variable name or expression containing array of records to insert"
        },
        "returning": {
          "type": "string",
          "description": "Variable name to store inserted records"
        }
      }
    },
    "httpCallAction": {
      "type": "object",
      "required": ["type", "url", "method"],
      "properties": {
        "type": { "const": "http.call" },
        "url": {
          "type": "string",
          "description": "HTTP endpoint URL (supports template expressions)"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"],
          "description": "HTTP method"
        },
        "headers": {
          "type": "object",
          "description": "Request headers",
          "additionalProperties": { "type": "string" }
        },
        "body": {
          "description": "Request body (supports template expressions)"
        },
        "into": {
          "type": "string",
          "description": "Variable name to store HTTP response"
        },
        "timeout": {
          "type": "number",
          "description": "Request timeout in milliseconds"
        }
      }
    },
    "transactionAction": {
      "type": "object",
      "required": ["type", "actions"],
      "properties": {
        "type": { "const": "transaction" },
        "actions": {
          "type": "array",
          "description": "Actions to execute within a database transaction",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "parallelAction": {
      "type": "object",
      "required": ["type", "actions"],
      "properties": {
        "type": { "const": "parallel" },
        "actions": {
          "type": "array",
          "description": "Actions to execute in parallel",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "responseMapAction": {
      "type": "object",
      "required": ["type", "fields"],
      "properties": {
        "type": { "const": "response.map" },
        "fields": {
          "type": "object",
          "description": "Response field mappings (supports nested objects and template expressions)",
          "additionalProperties": true
        },
        "statusCode": {
          "type": "number",
          "description": "HTTP status code (default: 200)"
        }
      }
    },
    "tryAction": {
      "type": "object",
      "required": ["type", "actions", "catch"],
      "properties": {
        "type": { "const": "try" },
        "actions": {
          "type": "array",
          "description": "Actions to attempt execution",
          "items": { "$ref": "#/definitions/action" }
        },
        "catch": {
          "type": "array",
          "description": "Actions to execute if an error occurs",
          "items": { "$ref": "#/definitions/action" }
        },
        "finally": {
          "type": "array",
          "description": "Actions to always execute after try/catch",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "cacheGetAction": {
      "type": "object",
      "required": ["type", "key", "into"],
      "properties": {
        "type": { "const": "cache.get" },
        "key": {
          "type": "string",
          "description": "Cache key (supports template expressions like 'projects:{{params.id}}')"
        },
        "into": {
          "type": "string",
          "description": "Variable name to store cached value (will be null if not found)"
        },
        "ttl": {
          "type": "number",
          "description": "Time-to-live in seconds (optional, for cache validation)"
        }
      }
    },
    "cacheSetAction": {
      "type": "object",
      "required": ["type", "key", "value"],
      "properties": {
        "type": { "const": "cache.set" },
        "key": {
          "type": "string",
          "description": "Cache key (supports template expressions like 'projects:{{params.id}}')"
        },
        "value": {
          "type": "string",
          "description": "Value to cache (supports template expressions like '{{projectData}}')"
        },
        "ttl": {
          "type": "number",
          "description": "Time-to-live in seconds (default: no expiration)"
        }
      }
    },
    "cacheDeleteAction": {
      "type": "object",
      "required": ["type", "key"],
      "properties": {
        "type": { "const": "cache.delete" },
        "key": {
          "type": "string",
          "description": "Cache key to delete (supports template expressions)"
        },
        "pattern": {
          "type": "string",
          "description": "Pattern for bulk deletion (e.g., 'projects:*')"
        }
      }
    }
  }
}
