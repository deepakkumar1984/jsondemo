{
  "apps": [
    {
      "id": "main",
      "name": "Main Application",
      "description": "Project and task management with analytics",
      "defaultRoute": "/tasks",
      "routes": [
        {
          "path": "/projects",
          "page": "projects",
          "requiresAuth": true
        },
        {
          "path": "/tasks",
          "page": "task-list",
          "requiresAuth": true
        },
        {
          "path": "/board",
          "page": "kanban-board",
          "requiresAuth": true
        },
        {
          "path": "/tasks/:id",
          "page": "task-detail",
          "requiresAuth": true
        },
        {
          "path": "/analytics",
          "page": "analytics-dashboard",
          "requiresAuth": true
        }
      ],
      "navigation": {
        "categories": [
          {
            "title": "Work",
            "items": [
              {
                "title": "Projects",
                "path": "/projects",
                "page": "projects",
                "icon": "FolderIcon",
                "description": "Manage projects"
              },
              {
                "title": "Tasks",
                "path": "/tasks",
                "page": "task-list",
                "icon": "ListIcon",
                "description": "View task list"
              },
              {
                "title": "Board",
                "path": "/board",
                "page": "kanban-board",
                "icon": "ViewBoardsIcon",
                "description": "Kanban board view"
              },
              {
                "title": "Analytics",
                "path": "/analytics",
                "page": "analytics-dashboard",
                "icon": "ChartBarIcon",
                "description": "Analytics dashboard"
              }
            ]
          }
        ]
      }
    }
  ]
}