{
  "apps": [
    {
      "id": "tasks-app",
      "name": "Task Manager",
      "subtitle": "Organize and track your work",
      "shortName": "Tasks",
      "description": "A sleek task management application with glossy styling and top navigation.",
      "prefix": "/",
      "branding": {
        "logo": "✅",
        "companyName": "MyCompany",
        "tagline": "Stay on top of everything"
      },
      "theme": {
        "mode": "light",
        "allowModeToggle": true
      },
      "icons": {
        "library": "lucide",
        "size": "20px"
      },
      "navigation": {
        "categories": [
          {
            "id": "category-tasks",
            "title": "Tasks",
            "icon": "LayoutDashboard",
            "order": 1,
            "items": [
              {
                "title": "All Tasks",
                "path": "/tasks",
                "page": "tasks/list",
                "icon": "List"
              },
              {
                "title": "Kanban Board",
                "path": "/tasks/kanban",
                "page": "tasks/kanban",
                "icon": "Kanban"
              },
              {
                "title": "Create Task",
                "path": "/tasks/new",
                "page": "tasks/create",
                "icon": "PlusCircle"
              }
            ]
          }
        ]
      },
      "routes": [
        {
          "path": "/tasks",
          "page": "tasks/list"
        },
        {
          "path": "/tasks/kanban",
          "page": "tasks/kanban"
        },
        {
          "path": "/tasks/new",
          "page": "tasks/create"
        },
        {
          "path": "/tasks/:id",
          "page": "tasks/detail"
        },
        {
          "path": "/tasks/:id/edit",
          "page": "tasks/edit"
        }
      ]
    },
    {
      "id": "todo-app",
      "name": "Todo App",
      "subtitle": "Simple todo management",
      "shortName": "Todo",
      "description": "A minimal todo application with API endpoints.",
      "prefix": "/",
      "branding": {
        "logo": "✅",
        "companyName": "MyCompany",
        "tagline": "Stay on top of everything"
      },
      "theme": {
        "mode": "light",
        "allowModeToggle": true
      },
      "icons": {
        "library": "lucide",
        "size": "20px"
      },
      "navigation": {
        "categories": [
          {
            "id": "category-todo",
            "title": "Todo",
            "icon": "CheckSquare",
            "order": 2,
            "items": [
              {
                "title": "All Todos",
                "path": "/todos",
                "page": "todo/list",
                "icon": "List"
              },
              {
                "title": "Create Todo",
                "path": "/todos/new",
                "page": "todo/create",
                "icon": "PlusCircle"
              }
            ]
          }
        ]
      },
      "routes": [
        {
          "path": "/todos",
          "page": "todo/list"
        },
        {
          "path": "/todos/new",
          "page": "todo/create"
        },
        {
          "path": "/todos/:id",
          "page": "todo/detail"
        },
        {
          "path": "/todos/:id/edit",
          "page": "todo/edit"
        }
      ]
    }
  ]
}