{
  "name": "jsondemo-hrm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:routes-index && wrangler dev  --ip 0.0.0.0 --port ${PORT:-8001}",
    "build": "bun run validate:all && bun run build:routes-index && vite build && wrangler deploy --dry-run",
    "build:client": "vite build",
    "build:routes-index": "tsx scripts/build-routes-index.ts",
    "deploy": "bun run build:routes-index && vite build && wrangler deploy",
    "db:migrate": "tsx scripts/schema/migrate-to-data-api.ts",
    "validate:all": "tsx scripts/validate-config.ts --all",
    "typecheck": "tsc --noEmit",
    "ai:generate": "tsx scripts/ai-config-generator.ts",
    "ai:batch": "tsx scripts/batch-generate.ts"
  },
  "dependencies": {
    "@json-render/core": "^0.3.0",
    "@json-render/react": "^0.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.11.7",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260131.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.61.1"
  }
}
