{
  "table": "leave_types",
  "description": "Types of leave available",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true
    },
    {
      "name": "daysPerYear",
      "type": "integer",
      "notNull": true
    },
    {
      "name": "carryForward",
      "type": "boolean",
      "default": false
    },
    {
      "name": "active",
      "type": "boolean",
      "default": true
    }
  ]
}