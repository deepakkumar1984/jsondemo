{
  "table": "salary_structures",
  "description": "Salary structure templates",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true
    },
    {
      "name": "description",
      "type": "text"
    },
    {
      "name": "active",
      "type": "boolean",
      "default": true
    },
    {
      "name": "createdAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    }
  ]
}