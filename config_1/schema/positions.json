{
  "table": "positions",
  "description": "Job positions within the organization",
  "columns": [
    {
      "name": "id",
      "type": "text",
      "primaryKey": true,
      "defaultFn": "uuid"
    },
    {
      "name": "title",
      "type": "text",
      "notNull": true
    },
    {
      "name": "code",
      "type": "text",
      "unique": true,
      "notNull": true
    },
    {
      "name": "departmentId",
      "type": "text",
      "references": {
        "table": "departments",
        "column": "id"
      }
    },
    {
      "name": "level",
      "type": "integer"
    },
    {
      "name": "minSalary",
      "type": "real"
    },
    {
      "name": "maxSalary",
      "type": "real"
    },
    {
      "name": "active",
      "type": "boolean",
      "default": true
    },
    {
      "name": "createdAt",
      "type": "text",
      "default": "CURRENT_TIMESTAMP"
    }
  ]
}