{
  "dataSources": {
    "reviews": { "url": "/api/talent/reviews" }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Performance Reviews",
        "subtitle": "Track and manage employee performance evaluations"
      }
    },
    {
      "type": "Alert",
      "props": {
        "variant": "info",
        "title": "Under Development",
        "message": "Performance review management is under development. Some features may not be available yet."
      }
    },
    {
      "type": "DataTable",
      "props": {
        "dataPath": "reviews",
        "searchable": true,
        "searchPlaceholder": "Search performance reviews...",
        "paginated": true,
        "pageSize": 20,
        "emptyMessage": "No performance reviews found.",
        "columns": [
          {
            "key": "employeeName",
            "header": "Employee",
            "sortable": true
          },
          {
            "key": "reviewerName",
            "header": "Reviewer",
            "sortable": true
          },
          {
            "key": "period",
            "header": "Period",
            "sortable": true
          },
          {
            "key": "rating",
            "header": "Rating",
            "sortable": true,
            "render": {
              "type": "Badge",
              "props": {
                "valuePath": "rating",
                "colorMap": {
                  "Excellent": "green",
                  "Good": "blue",
                  "Average": "orange",
                  "Below Average": "red",
                  "Poor": "red"
                }
              }
            }
          },
          {
            "key": "status",
            "header": "Status",
            "sortable": true,
            "render": {
              "type": "Badge",
              "props": {
                "valuePath": "status",
                "colorMap": {
                  "draft": "gray",
                  "submitted": "blue",
                  "acknowledged": "green"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
