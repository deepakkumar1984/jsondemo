{
  "dataSources": {
    "jobs": { "url": "/api/talent/jobs" }
  },
  "children": [
    {
      "type": "PageHeader",
      "props": {
        "title": "Job Postings",
        "subtitle": "Manage open positions and recruitment"
      }
    },
    {
      "type": "Alert",
      "props": {
        "variant": "info",
        "title": "Under Development",
        "message": "Talent management module is under development. Some features may not be available yet."
      }
    },
    {
      "type": "DataTable",
      "props": {
        "dataPath": "jobs",
        "searchable": true,
        "searchPlaceholder": "Search job postings...",
        "paginated": true,
        "pageSize": 20,
        "emptyMessage": "No job postings found.",
        "columns": [
          {
            "key": "title",
            "header": "Title",
            "sortable": true
          },
          {
            "key": "departmentName",
            "header": "Department",
            "sortable": true
          },
          {
            "key": "status",
            "header": "Status",
            "sortable": true,
            "render": {
              "type": "Badge",
              "props": {
                "valuePath": "status",
                "colorMap": {
                  "open": "green",
                  "closed": "gray",
                  "draft": "blue"
                }
              }
            }
          },
          {
            "key": "postedDate",
            "header": "Posted Date",
            "format": "date",
            "sortable": true
          },
          {
            "key": "closingDate",
            "header": "Closing Date",
            "format": "date",
            "sortable": true
          }
        ]
      }
    }
  ]
}
