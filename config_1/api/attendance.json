{
  "resource": "attendance",
  "basePath": "/api/attendance",
  "description": "Employee attendance tracking API",
  "table": "attendance",
  "auth": {
    "required": true
  },
  "operations": {
    "list": {
      "enabled": true,
      "filters": [
        {
          "field": "employeeId",
          "operator": "equals",
          "queryParam": "employeeId"
        },
        {
          "field": "date",
          "operator": "equals",
          "queryParam": "date"
        }
      ],
      "sort": {
        "default": "date",
        "defaultOrder": "desc",
        "allowed": ["date", "checkIn", "checkOut", "status"]
      },
      "pagination": {
        "enabled": true,
        "defaultLimit": 50,
        "maxLimit": 100
      },
      "relations": [
        {
          "name": "employee",
          "table": "employees",
          "foreignKey": "employeeId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "getById": {
      "enabled": true,
      "idField": "id",
      "relations": [
        {
          "name": "employee",
          "table": "employees",
          "foreignKey": "employeeId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "create": {
      "enabled": true,
      "validation": {
        "required": ["employeeId", "date"],
        "fields": {
          "status": {
            "type": "string",
            "enum": ["present", "absent", "half-day", "on-leave"]
          },
          "hoursWorked": {
            "type": "number",
            "min": 0,
            "max": 24
          }
        }
      },
      "defaults": {
        "status": "present"
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "check_exists",
            "check_exists": {
              "table": "employees",
              "where": {
                "id": "{{body.employeeId}}"
              },
              "onNotExists": "return_error",
              "error": {
                "message": "Employee not found",
                "code": 404
              }
            }
          }
        ]
      }
    },
    "update": {
      "enabled": true,
      "idField": "id",
      "validation": {
        "fields": {
          "status": {
            "type": "string",
            "enum": ["present", "absent", "half-day", "on-leave"]
          },
          "hoursWorked": {
            "type": "number",
            "min": 0,
            "max": 24
          }
        }
      }
    },
    "delete": {
      "enabled": true,
      "idField": "id",
      "softDelete": {
        "enabled": false
      }
    }
  }
}
