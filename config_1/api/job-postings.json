{
  "resource": "jobPostings",
  "basePath": "/api/job-postings",
  "description": "Job posting management API for recruitment",
  "table": "jobPostings",
  "auth": {
    "required": true
  },
  "operations": {
    "list": {
      "enabled": true,
      "filters": [
        {
          "field": "status",
          "operator": "equals",
          "queryParam": "status"
        },
        {
          "field": "departmentId",
          "operator": "equals",
          "queryParam": "departmentId"
        }
      ],
      "sort": {
        "default": "postedDate",
        "defaultOrder": "desc",
        "allowed": ["postedDate", "closingDate", "title", "status"]
      },
      "pagination": {
        "enabled": true,
        "defaultLimit": 50,
        "maxLimit": 100
      },
      "relations": [
        {
          "name": "department",
          "table": "departments",
          "foreignKey": "departmentId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "position",
          "table": "positions",
          "foreignKey": "positionId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "getById": {
      "enabled": true,
      "idField": "id",
      "relations": [
        {
          "name": "department",
          "table": "departments",
          "foreignKey": "departmentId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "position",
          "table": "positions",
          "foreignKey": "positionId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "create": {
      "enabled": true,
      "validation": {
        "required": ["title"],
        "fields": {
          "title": {
            "type": "string",
            "min": 5,
            "max": 255
          },
          "status": {
            "type": "string",
            "enum": ["draft", "open", "closed", "on-hold"]
          }
        }
      },
      "defaults": {
        "status": "draft"
      }
    },
    "update": {
      "enabled": true,
      "idField": "id",
      "validation": {
        "fields": {
          "title": {
            "type": "string",
            "min": 5,
            "max": 255
          },
          "status": {
            "type": "string",
            "enum": ["draft", "open", "closed", "on-hold"]
          }
        }
      }
    },
    "delete": {
      "enabled": true,
      "idField": "id",
      "softDelete": {
        "enabled": false
      }
    }
  }
}
