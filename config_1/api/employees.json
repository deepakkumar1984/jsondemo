{
  "resource": "employees",
  "basePath": "/api/employees",
  "description": "Employee management API with comprehensive CRUD and custom operations",
  "table": "employees",
  "auth": {
    "required": true
  },
  "operations": {
    "list": {
      "enabled": true,
      "filters": [
        {
          "field": "departmentId",
          "operator": "equals",
          "queryParam": "departmentId"
        },
        {
          "field": "status",
          "operator": "equals",
          "queryParam": "status"
        },
        {
          "field": "employmentType",
          "operator": "equals",
          "queryParam": "employmentType"
        },
        {
          "field": "positionId",
          "operator": "equals",
          "queryParam": "positionId"
        },
        {
          "field": "managerId",
          "operator": "equals",
          "queryParam": "managerId"
        }
      ],
      "search": {
        "enabled": true,
        "fields": ["firstName", "lastName", "employeeCode", "email"]
      },
      "sort": {
        "default": "createdAt",
        "defaultOrder": "desc",
        "allowed": ["createdAt", "firstName", "lastName", "employeeCode", "dateOfJoining"]
      },
      "pagination": {
        "enabled": true,
        "defaultLimit": 50,
        "maxLimit": 100
      },
      "relations": [
        {
          "name": "department",
          "table": "departments",
          "foreignKey": "departmentId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "position",
          "table": "positions",
          "foreignKey": "positionId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "getById": {
      "enabled": true,
      "idField": "id",
      "relations": [
        {
          "name": "department",
          "table": "departments",
          "foreignKey": "departmentId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "position",
          "table": "positions",
          "foreignKey": "positionId",
          "referencedKey": "id",
          "type": "one"
        },
        {
          "name": "manager",
          "table": "employees",
          "foreignKey": "managerId",
          "referencedKey": "id",
          "type": "one"
        }
      ]
    },
    "create": {
      "enabled": true,
      "validation": {
        "required": ["firstName", "lastName", "email", "dateOfJoining", "employmentType"],
        "fields": {
          "firstName": {
            "type": "string",
            "min": 2,
            "max": 100
          },
          "lastName": {
            "type": "string",
            "min": 2,
            "max": 100
          },
          "email": {
            "type": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^[+]?[0-9]{10,15}$"
          },
          "employmentType": {
            "type": "string",
            "enum": ["full-time", "part-time", "contract", "intern"]
          },
          "status": {
            "type": "string",
            "enum": ["active", "on-leave", "suspended", "terminated"]
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female", "other", "prefer-not-to-say"]
          },
          "maritalStatus": {
            "type": "string",
            "enum": ["single", "married", "divorced", "widowed"]
          }
        }
      },
      "defaults": {
        "status": "active"
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "check_exists",
            "check_exists": {
              "table": "employees",
              "where": {
                "email": "{{body.email}}"
              },
              "onExists": "return_error",
              "error": {
                "message": "Employee with this email already exists",
                "code": 409
              }
            }
          },
          {
            "type": "conditional",
            "conditional": {
              "condition": {
                "field": "body.departmentId",
                "operator": "not_equals",
                "value": null
              },
              "then": [
                {
                  "type": "check_exists",
                  "check_exists": {
                    "table": "departments",
                    "where": {
                      "id": "{{body.departmentId}}"
                    },
                    "onNotExists": "return_error",
                    "error": {
                      "message": "Department not found",
                      "code": 404
                    }
                  }
                }
              ]
            }
          },
          {
            "type": "conditional",
            "conditional": {
              "condition": {
                "field": "body.positionId",
                "operator": "not_equals",
                "value": null
              },
              "then": [
                {
                  "type": "check_exists",
                  "check_exists": {
                    "table": "positions",
                    "where": {
                      "id": "{{body.positionId}}"
                    },
                    "onNotExists": "return_error",
                    "error": {
                      "message": "Position not found",
                      "code": 404
                    }
                  }
                }
              ]
            }
          },
          {
            "type": "db_query",
            "db_query": {
              "action": "count",
              "table": "employees",
              "storeAs": "employeeCount"
            }
          },
          {
            "type": "set_variable",
            "set_variable": {
              "name": "nextNumber",
              "value": "{{employeeCount + 1}}"
            }
          },
          {
            "type": "set_variable",
            "set_variable": {
              "name": "paddedNumber",
              "value": "{{String(nextNumber).padStart(4, '0')}}"
            }
          },
          {
            "type": "set_variable",
            "set_variable": {
              "name": "body.employeeCode",
              "value": "EMP-{{paddedNumber}}"
            }
          }
        ]
      }
    },
    "update": {
      "enabled": true,
      "idField": "id",
      "validation": {
        "fields": {
          "firstName": {
            "type": "string",
            "min": 2,
            "max": 100
          },
          "lastName": {
            "type": "string",
            "min": 2,
            "max": 100
          },
          "email": {
            "type": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^[+]?[0-9]{10,15}$"
          },
          "employmentType": {
            "type": "string",
            "enum": ["full-time", "part-time", "contract", "intern"]
          },
          "status": {
            "type": "string",
            "enum": ["active", "on-leave", "suspended", "terminated"]
          }
        }
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "conditional",
            "conditional": {
              "condition": {
                "field": "body.departmentId",
                "operator": "not_equals",
                "value": null
              },
              "then": [
                {
                  "type": "check_exists",
                  "check_exists": {
                    "table": "departments",
                    "where": {
                      "id": "{{body.departmentId}}"
                    },
                    "onNotExists": "return_error",
                    "error": {
                      "message": "Department not found",
                      "code": 404
                    }
                  }
                }
              ]
            }
          },
          {
            "type": "conditional",
            "conditional": {
              "condition": {
                "field": "body.positionId",
                "operator": "not_equals",
                "value": null
              },
              "then": [
                {
                  "type": "check_exists",
                  "check_exists": {
                    "table": "positions",
                    "where": {
                      "id": "{{body.positionId}}"
                    },
                    "onNotExists": "return_error",
                    "error": {
                      "message": "Position not found",
                      "code": 404
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "delete": {
      "enabled": true,
      "idField": "id",
      "softDelete": {
        "enabled": true,
        "field": "status"
      },
      "beforeExecute": {
        "steps": [
          {
            "type": "db_query",
            "db_query": {
              "action": "select",
              "table": "employees",
              "where": {
                "id": "{{params.id}}"
              },
              "limit": 1,
              "storeAs": "employee"
            }
          },
          {
            "type": "set_variable",
            "set_variable": {
              "name": "body.status",
              "value": "terminated"
            }
          }
        ]
      }
    },
    "custom": [
      {
        "path": "/stats",
        "method": "GET",
        "description": "Get employee statistics",
        "workflow": {
          "steps": [
            {
              "type": "db_query",
              "db_query": {
                "action": "count",
                "table": "employees",
                "where": {
                  "status": "active"
                },
                "storeAs": "activeCount"
              }
            },
            {
              "type": "db_query",
              "db_query": {
                "action": "count",
                "table": "employees",
                "storeAs": "totalCount"
              }
            },
            {
              "type": "db_query",
              "db_query": {
                "action": "count",
                "table": "employees",
                "where": {
                  "employmentType": "full-time"
                },
                "storeAs": "fullTimeCount"
              }
            },
            {
              "type": "db_query",
              "db_query": {
                "action": "count",
                "table": "employees",
                "where": {
                  "employmentType": "contract"
                },
                "storeAs": "contractCount"
              }
            },
            {
              "type": "set_variable",
              "set_variable": {
                "name": "stats",
                "value": {
                  "total": "{{totalCount}}",
                  "active": "{{activeCount}}",
                  "fullTime": "{{fullTimeCount}}",
                  "contract": "{{contractCount}}"
                }
              }
            },
            {
              "type": "return_response",
              "return_response": {
                "data": "stats"
              }
            }
          ]
        }
      },
      {
        "path": "/:id/documents",
        "method": "GET",
        "description": "List employee documents",
        "workflow": {
          "steps": [
            {
              "type": "check_exists",
              "check_exists": {
                "table": "employees",
                "where": {
                  "id": "{{params.id}}"
                },
                "onNotExists": "return_error",
                "error": {
                  "message": "Employee not found",
                  "code": 404
                }
              }
            },
            {
              "type": "db_query",
              "db_query": {
                "action": "select",
                "table": "employee_documents",
                "where": {
                  "employeeId": "{{params.id}}"
                },
                "orderBy": {
                  "field": "createdAt",
                  "order": "desc"
                },
                "storeAs": "documents"
              }
            },
            {
              "type": "return_response",
              "return_response": {
                "data": "documents"
              }
            }
          ]
        }
      },
      {
        "path": "/:id/documents",
        "method": "POST",
        "description": "Upload employee document",
        "validation": {
          "required": ["documentType", "documentUrl"],
          "fields": {
            "documentType": {
              "type": "string",
              "enum": ["resume", "offer-letter", "id-proof", "address-proof", "certificate", "other"]
            },
            "documentUrl": {
              "type": "url"
            }
          }
        },
        "workflow": {
          "steps": [
            {
              "type": "check_exists",
              "check_exists": {
                "table": "employees",
                "where": {
                  "id": "{{params.id}}"
                },
                "onNotExists": "return_error",
                "error": {
                  "message": "Employee not found",
                  "code": 404
                }
              }
            },
            {
              "type": "db_query",
              "db_query": {
                "action": "insert",
                "table": "employee_documents",
                "data": {
                  "id": "{{crypto.randomUUID()}}",
                  "employeeId": "{{params.id}}",
                  "documentType": "{{body.documentType}}",
                  "documentUrl": "{{body.documentUrl}}",
                  "documentName": "{{body.documentName}}",
                  "uploadedBy": "{{user.id}}",
                  "createdAt": "{{new Date().toISOString()}}"
                },
                "storeAs": "document"
              }
            },
            {
              "type": "return_response",
              "return_response": {
                "data": "document",
                "status": 201
              }
            }
          ]
        }
      }
    ]
  }
}
