{
  "table": "budgets",
  "description": "Schema for managing budgets",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "notNull": true,
      "defaultFn": "uuid",
      "description": "Unique identifier for the budget"
    },
    {
      "name": "period_start",
      "type": "date",
      "notNull": true,
      "description": "Start date of the budget period"
    },
    {
      "name": "period_end",
      "type": "date",
      "notNull": true,
      "description": "End date of the budget period"
    },
    {
      "name": "category_id",
      "type": "uuid",
      "notNull": false,
      "references": {
        "table": "expense_categories",
        "column": "id"
      },
      "description": "Foreign key to expense_categories.id, optional for overall budget"
    },
    {
      "name": "amount",
      "type": "decimal",
      "notNull": true,
      "description": "Budget amount"
    },
    {
      "name": "currency",
      "type": "text",
      "notNull": true,
      "default": "USD",
      "description": "Currency code, defaults to USD"
    },
    {
      "name": "notes",
      "type": "text",
      "notNull": false,
      "description": "Optional notes for the budget"
    },
    {
      "name": "created_by",
      "type": "uuid",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id"
      },
      "description": "Foreign key to users.id, required for audit"
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "notNull": true,
      "description": "Timestamp when the budget was created"
    },
    {
      "name": "updated_at",
      "type": "timestamptz",
      "notNull": true,
      "description": "Timestamp when the budget was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_budgets_created_by_period_start",
      "columns": [
        "created_by",
        "period_start"
      ],
      "unique": false
    },
    {
      "name": "idx_budgets_category_id",
      "columns": [
        "category_id"
      ],
      "unique": false
    },
    {
      "name": "idx_budgets_unique_constraint",
      "columns": [
        "created_by",
        "period_start",
        "period_end",
        "category_id",
        "currency"
      ],
      "unique": true
    }
  ]
}