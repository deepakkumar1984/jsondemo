{
  "table": "vendors",
  "description": "Table for storing vendor information including name, website, notes, and timestamps.",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "defaultFn": "uuid"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true
    },
    {
      "name": "website",
      "type": "text",
      "notNull": false
    },
    {
      "name": "notes",
      "type": "text",
      "notNull": false
    },
    {
      "name": "created_at",
      "type": "timestamptz"
    },
    {
      "name": "updated_at",
      "type": "timestamptz"
    }
  ],
  "indexes": [
    {
      "name": "vendors_name_unique",
      "columns": [
        "name"
      ],
      "unique": true
    }
  ]
}