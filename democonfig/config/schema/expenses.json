{
  "table": "expenses",
  "description": "Schema for expense records",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "notNull": true,
      "defaultFn": "uuid",
      "description": "Unique identifier for the expense"
    },
    {
      "name": "expense_date",
      "type": "date",
      "notNull": true,
      "description": "Date of the expense"
    },
    {
      "name": "amount",
      "type": "decimal",
      "notNull": true,
      "description": "Amount of the expense"
    },
    {
      "name": "currency",
      "type": "text",
      "notNull": false,
      "default": "USD",
      "description": "Currency of the expense"
    },
    {
      "name": "description",
      "type": "text",
      "notNull": false,
      "description": "Description of the expense"
    },
    {
      "name": "category_id",
      "type": "uuid",
      "notNull": true,
      "references": {
        "table": "expense_categories",
        "column": "id"
      },
      "description": "Foreign key to expense_categories table"
    },
    {
      "name": "vendor_id",
      "type": "uuid",
      "notNull": false,
      "references": {
        "table": "vendors",
        "column": "id"
      },
      "description": "Foreign key to vendors table"
    },
    {
      "name": "payment_account_id",
      "type": "uuid",
      "notNull": false,
      "references": {
        "table": "payment_accounts",
        "column": "id"
      },
      "description": "Foreign key to payment_accounts table"
    },
    {
      "name": "reimbursable",
      "type": "boolean",
      "notNull": false,
      "default": false,
      "description": "Whether the expense is reimbursable"
    },
    {
      "name": "status",
      "type": "text",
      "notNull": false,
      "default": "posted",
      "enum": [
        "draft",
        "posted",
        "reimbursed"
      ],
      "description": "Status of the expense"
    },
    {
      "name": "receipt_url",
      "type": "text",
      "notNull": false,
      "description": "URL to the receipt"
    },
    {
      "name": "created_by",
      "type": "uuid",
      "notNull": true,
      "references": {
        "table": "users",
        "column": "id"
      },
      "description": "Foreign key to users table for creator"
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "notNull": true,
      "description": "Timestamp when the expense was created"
    },
    {
      "name": "updated_at",
      "type": "timestamptz",
      "notNull": true,
      "description": "Timestamp when the expense was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_expenses_created_by_expense_date",
      "columns": [
        "created_by",
        "expense_date"
      ],
      "unique": false
    },
    {
      "name": "idx_expenses_category_id",
      "columns": [
        "category_id"
      ],
      "unique": false
    },
    {
      "name": "idx_expenses_vendor_id",
      "columns": [
        "vendor_id"
      ],
      "unique": false
    },
    {
      "name": "idx_expenses_status",
      "columns": [
        "status"
      ],
      "unique": false
    }
  ]
}