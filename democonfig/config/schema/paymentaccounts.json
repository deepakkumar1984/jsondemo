{
  "table": "payment_accounts",
  "description": "Table for storing payment accounts",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "notNull": true,
      "defaultFn": "uuid",
      "description": "Unique identifier for the payment account"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true,
      "description": "Name of the payment account"
    },
    {
      "name": "type",
      "type": "text",
      "notNull": true,
      "enum": [
        "cash",
        "credit_card",
        "bank",
        "other"
      ],
      "description": "Type of the payment account"
    },
    {
      "name": "last4",
      "type": "text",
      "notNull": false,
      "description": "Last four digits of the account number (optional)"
    },
    {
      "name": "is_active",
      "type": "boolean",
      "notNull": true,
      "default": true,
      "description": "Indicates if the payment account is active"
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "notNull": true,
      "description": "Timestamp when the record was created"
    },
    {
      "name": "updated_at",
      "type": "timestamptz",
      "notNull": true,
      "description": "Timestamp when the record was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_payment_accounts_is_active",
      "columns": [
        "is_active"
      ],
      "unique": false
    },
    {
      "name": "idx_payment_accounts_name_unique",
      "columns": [
        "name"
      ],
      "unique": true
    }
  ]
}