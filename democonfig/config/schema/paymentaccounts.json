{
  "table": "payment_accounts",
  "description": "Payment accounts for tracking expense payment methods",
  "columns": [
    {
      "name": "id",
      "type": "uuid",
      "primaryKey": true,
      "defaultFn": "uuid",
      "description": "Unique payment account identifier"
    },
    {
      "name": "name",
      "type": "text",
      "notNull": true,
      "unique": true,
      "description": "Name of the payment account"
    },
    {
      "name": "type",
      "type": "text",
      "notNull": true,
      "enum": [
        "cash",
        "credit_card",
        "bank",
        "other"
      ],
      "description": "Type of payment account"
    },
    {
      "name": "last4",
      "type": "text",
      "notNull": false,
      "description": "Last four digits of the account number"
    },
    {
      "name": "is_active",
      "type": "boolean",
      "notNull": true,
      "default": true,
      "description": "Whether the payment account is active"
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the payment account was created"
    },
    {
      "name": "updated_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "CURRENT_TIMESTAMP",
      "description": "Timestamp when the payment account was last updated"
    }
  ],
  "indexes": [
    {
      "name": "idx_payment_accounts_name",
      "columns": [
        "name"
      ],
      "unique": true
    },
    {
      "name": "idx_payment_accounts_is_active",
      "columns": [
        "is_active"
      ]
    }
  ]
}