# Cloudflare AI Gateway Configuration
# Get your gateway URL from: https://dash.cloudflare.com/ai/ai-gateway
# Format: https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/YOUR_GATEWAY_ID

# API Key - Use one of these options:
# Option 1: Bring Your Own Key (BYOK) - Use provider-specific keys
ANTHROPIC_API_KEY=your-anthropic-key-here
# OPENAI_API_KEY=your-openai-key-here
# GOOGLE_API_KEY=your-google-key-here

# Option 2: Cloudflare API Token (if keys configured in gateway dashboard)
# CLOUDFLARE_API_TOKEN=your-cloudflare-token-here

# Model to use (full provider/model format)
# Anthropic: anthropic/claude-3-5-sonnet, anthropic/claude-3-opus
# OpenAI: openai/gpt-4, openai/gpt-4-turbo
# Google: google/gemini-pro, google/gemini-1.5-pro
CLOUDFLARE_MODEL=anthropic/claude-3-5-sonnet
